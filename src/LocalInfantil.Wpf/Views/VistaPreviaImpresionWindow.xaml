<Window x:Class="LocalInfantil.Wpf.Views.VistaPreviaImpresionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vista previa de impresión de prueba"
        Width="840"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DocumentViewer x:Name="VistaDocumento" Grid.Row="0" />
        <TextBlock x:Name="MensajeEstado"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   Foreground="#374151"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="2"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0" Padding="14,7" Click="Imprimir_Click" Content="Imprimir…" />
            <Button Padding="14,7" IsCancel="True" Content="Cerrar" />
        </StackPanel>
    </Grid>
</Window>
