<UserControl x:Class="LocalInfantil.Wpf.Views.ShellEmpleadaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24">
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8" Margin="-24,-24,-24,24">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Identidad}"/>
                <Button DockPanel.Dock="Right" Content="Cerrar sesión" Padding="8,3" Click="Cerrar_Click"/>
            </DockPanel>
        </Border>
        <TextBlock TextWrapping="Wrap" Foreground="#6B7280" Text="Sesión iniciada como empleada. La administración de usuarios y permisos requiere Dueña."/>
    </DockPanel>
</UserControl>
