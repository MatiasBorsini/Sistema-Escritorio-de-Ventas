<UserControl x:Class="LocalInfantil.Wpf.Views.ApartadoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Stock no vendible — apartar, reincorporar, baja definitiva"/>
            <TextBlock Foreground="#6B7280" TextWrapping="Wrap" Text="Físico = disponible + apartado. Apartar y reincorporar no alteran el físico; la baja definitiva sí." Margin="0,4,0,8"/>
            <TextBlock Foreground="#DC2626" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Foreground="#059669" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="160" Text="{Binding SkuBusqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="SKU exacto"/>
                <Button Content="Buscar" Margin="8,0,0,0" Padding="8,4" Command="{Binding BuscarCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Físico: "/><TextBlock Text="{Binding Existencia.Fisico, FallbackValue=—}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Text="Disponible: "/><TextBlock Text="{Binding Existencia.Disponible, FallbackValue=—}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Text="Apartado: "/><TextBlock Text="{Binding Existencia.Apartado, FallbackValue=—}" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="100" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera >0"/>
                <TextBox Width="260" Margin="8,0,0,0" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Apartar" Padding="8,4" Command="{Binding ApartarCommand}"/>
                <Button Content="Reincorporar" Margin="8,0,0,0" Padding="8,4" Command="{Binding ReincorporarCommand}"/>
                <Button Content="Solicitar baja definitiva" Margin="8,0,0,0" Padding="8,4" Command="{Binding SolicitarBajaCommand}"/>
                <Button Content="Cancelar baja" Margin="8,0,0,0" Padding="8,4" Command="{Binding CancelarBajaCommand}"/>
            </StackPanel>
            <Border Margin="0,0,0,8" Padding="8" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" Visibility="{Binding ConfirmacionBajaVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Foreground="#991B1B" TextWrapping="Wrap" Text="¿Confirmás la BAJA DEFINITIVA? Esas unidades dejan de existir físicamente. Esta acción no se puede deshacer desde esta pantalla."/>
                    <Button Content="Confirmar baja definitiva" Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Left" Command="{Binding ConfirmarBajaCommand}"/>
                </StackPanel>
            </Border>
            <GroupBox Header="Historial (apartados, reincorporaciones y bajas)" Padding="8">
                <ItemsControl ItemsSource="{Binding Historial}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Tipo}" Width="110"/>
                                    <TextBlock Text="{Binding Cantidad}" Width="60"/>
                                    <TextBlock Text="{Binding Motivo}" Width="200" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Foreground="#6B7280" FontSize="11" Text="{Binding ResponsableNombre, FallbackValue=—}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
