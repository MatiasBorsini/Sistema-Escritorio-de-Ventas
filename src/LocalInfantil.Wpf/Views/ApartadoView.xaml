<UserControl x:Class="LocalInfantil.Wpf.Views.ApartadoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0">
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Inventario" Margin="0,0,0,0"/>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Consultá una variante y gestioná prendas temporalmente fuera de venta o dadas de baja." Margin="0,0,0,2"/>
            <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
        </StackPanel>
        <Grid Margin="20,2,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Consultar variante"/>
                            <StackPanel Style="{StaticResource EstiloToolbar}" Orientation="Horizontal">
                                <views:BuscadorAsistido Width="280" Modo="Variante" Motor="{Binding MotorSugerencias}"
                                                        SeleccionCommand="{Binding SeleccionarSugerenciaCommand}"
                                                        BusquedaDirectaCommand="{Binding BuscarCommand}"
                                                        ToolTip="Código interno o nombre de producto"/>
                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Buscar" Command="{Binding BuscarCommand}"/>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Existencia.Sku, FallbackValue=Buscá una variante para ver su stock}" Visibility="{Binding Existencia, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,6,0" MinWidth="120">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EstiloNumeroMetrica}" FontSize="22" Text="{Binding Existencia.Fisico, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Físico · total existente"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Color.SuccessBgBrush}" BorderBrush="{StaticResource Color.SuccessTextBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,6,0" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EstiloNumeroMetricaDestacado}" FontSize="26" Text="{Binding Existencia.Disponible, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Disponible para vender"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" MinWidth="120">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EstiloNumeroMetrica}" FontSize="22" Text="{Binding Existencia.Apartado, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Apartado / no vendible"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="12" Text="Físico = Disponible + Apartado."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Gestionar disponibilidad"/>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="12" Text="Elegí la acción. Solo aparece el formulario necesario." Margin="0,0,0,4"/>
                            <Border Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource EstiloSegmento}" GroupName="AccionApartado" Content="Apartar" IsChecked="{Binding AccionApartarActiva, Mode=OneWay}" Command="{Binding SeleccionarAccionCommand}" CommandParameter="Apartar"/>
                                    <RadioButton Style="{StaticResource EstiloSegmento}" GroupName="AccionApartado" Content="Reincorporar" IsChecked="{Binding AccionReincorporarActiva, Mode=OneWay}" Command="{Binding SeleccionarAccionCommand}" CommandParameter="Reincorporar"/>
                                    <RadioButton Style="{StaticResource EstiloSegmento}" GroupName="AccionApartado" Content="Baja definitiva" IsChecked="{Binding AccionBajaActiva, Mode=OneWay}" Command="{Binding SeleccionarAccionCommand}" CommandParameter="Baja"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Visibility="{Binding PanelApartarVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Text="Retirar temporalmente de la venta. Baja el disponible, el total físico no cambia." Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Width="120" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera mayor a cero"/>
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Width="280" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio"/>
                                </StackPanel>
                                <Button Style="{StaticResource EstiloBotonPrimario}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Apartar prendas" Command="{Binding ApartarCommand}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding PanelReincorporarVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Text="Volver a dejar disponible para vender. Vuelve de apartado a disponible." Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Width="120" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera mayor a cero"/>
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Width="280" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio"/>
                                </StackPanel>
                                <Button Style="{StaticResource EstiloBotonPrimario}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Reincorporar prendas" Command="{Binding ReincorporarCommand}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding PanelBajaVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Text="Retirar definitivamente del inventario. Reduce el físico: esas unidades dejan de existir." Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Width="120" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera mayor a cero"/>
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Width="280" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource EstiloBotonDestructivo}" Content="Solicitar baja definitiva" Command="{Binding SolicitarBajaCommand}"/>
                                    <Button Style="{StaticResource EstiloBotonQuiet}" Content="Cancelar" Command="{Binding CancelarBajaCommand}"/>
                                </StackPanel>
                                <Border Margin="0,8,0,0" Padding="12" Background="{StaticResource Color.ErrorBgBrush}" BorderBrush="{StaticResource Color.ErrorTextBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding ConfirmacionBajaVisible, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Color.ErrorTextBrush}" TextWrapping="Wrap" Text="¿Confirmás la baja definitiva? Esas unidades dejan de existir físicamente y no se puede deshacer desde esta pantalla."/>
                                        <Button Style="{StaticResource EstiloBotonDestructivo}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Confirmar baja definitiva" Command="{Binding ConfirmarBajaCommand}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Margin="0" Padding="{StaticResource RellenoPanel}" VerticalAlignment="Top">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Historial" FontSize="15"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Últimos movimientos (máx. 20)"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Historial}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Ellipse Width="11" Height="11" Fill="{StaticResource Color.PrimaryBrush}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Tipo}"/>
                                                    <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Cantidad, StringFormat={}{0} u.}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding CreadoEn, Converter={StaticResource FechaCorta}}"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Motivo}" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding ResponsableNombre, FallbackValue=—}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EstiloEstadoVacio}" Text="Todavía no hay movimientos de clasificación para esta variante." Visibility="{Binding Historial.Count, Converter={StaticResource CeroVisible}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
