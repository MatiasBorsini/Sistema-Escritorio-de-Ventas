<UserControl x:Class="LocalInfantil.Wpf.Views.ApartadoView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:LocalInfantil.Wpf.Views" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <UserControl.Resources>
  <Style x:Key="EtiquetaInventario" TargetType="Label">
   <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="0,0,0,4"/>
   <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="CampoInventario" TargetType="TextBox" BasedOn="{StaticResource EstiloCampoTexto}">
   <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
   <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
    <Setter Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
   </Trigger></Style.Triggers>
  </Style>
 </UserControl.Resources>
 <ScrollViewer Background="{StaticResource Color.CanvasBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <Grid Margin="20,12,20,16" MaxWidth="1100" HorizontalAlignment="Stretch" KeyboardNavigation.TabNavigation="Continue">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,10">
    <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Inventario" Margin="0"/>
    <TextBlock Style="{StaticResource EstiloAyuda}" Text="Consultá una variante y gestioná su disponibilidad."/>
    <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
   </StackPanel>
   <Grid Grid.Row="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" Style="{StaticResource EstiloTarjeta}" Padding="16">
                        <StackPanel>
                            <Label Style="{StaticResource EtiquetaInventario}" Content="_Buscar variante" Target="{Binding ElementName=BusquedaVariante}"/>
                            <StackPanel Style="{StaticResource EstiloToolbar}" Orientation="Horizontal">
                                <views:BuscadorAsistido x:Name="BusquedaVariante" KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="Buscar variante" Width="280" Modo="Variante" Motor="{Binding MotorSugerencias}"
                                                        SeleccionCommand="{Binding SeleccionarSugerenciaCommand}"
                                                        BusquedaDirectaCommand="{Binding BuscarCommand}"
                                                        ToolTip="Código interno o nombre de producto"/>
                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Buscar" Command="{Binding BuscarCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ErrorGeneral}" Style="{StaticResource EstiloMensajeError}"/>
                            <TextBlock Margin="0,6,0,0" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Existencia.Sku, FallbackValue=Buscá una variante para ver su stock}" Visibility="{Binding Existencia, Converter={StaticResource NullToVisibility}, FallbackValue=Collapsed}"/>
                            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding DescripcionVariante}" Visibility="{Binding DescripcionVariante, Converter={StaticResource NullToVisibility}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,6,0" MinWidth="120">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EstiloNumeroMetrica}" FontSize="22" Text="{Binding Existencia.Fisico, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Físico"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Color.SuccessBgBrush}" BorderBrush="{StaticResource Color.SuccessTextBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,6,0" MinWidth="140">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EstiloNumeroMetricaDestacado}" FontSize="26" Text="{Binding Existencia.Disponible, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Disponible"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" MinWidth="120">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EstiloNumeroMetrica}" FontSize="22" Text="{Binding Existencia.Apartado, FallbackValue=—}"/>
                                        <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Apartado"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="12" Text="Físico = Disponible + Apartado."/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource EstiloTarjeta}" Padding="16" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Gestionar disponibilidad"/>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="12" Text="Elegí la acción. Solo aparece el formulario necesario." Margin="0,0,0,4"/>
                            <Border Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource EstiloSegmento}" GroupName="AccionApartado" Content="Apartar" IsChecked="{Binding AccionApartarActiva, Mode=OneWay}" Command="{Binding SeleccionarAccionCommand}" CommandParameter="Apartar"/>
                                    <RadioButton Style="{StaticResource EstiloSegmento}" GroupName="AccionApartado" Content="Reincorporar" IsChecked="{Binding AccionReincorporarActiva, Mode=OneWay}" Command="{Binding SeleccionarAccionCommand}" CommandParameter="Reincorporar"/>
                                    <RadioButton Style="{StaticResource EstiloSegmento}" GroupName="AccionApartado" Content="Baja definitiva" IsChecked="{Binding AccionBajaActiva, Mode=OneWay}" Command="{Binding SeleccionarAccionCommand}" CommandParameter="Baja"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Visibility="{Binding PanelApartarVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Text="Retirar temporalmente de la venta. Baja el disponible, el total físico no cambia." Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <Label Style="{StaticResource EtiquetaInventario}" Content="_Cantidad" Target="{Binding ElementName=CantidadApartar}"/>
                                        <TextBox x:Name="CantidadApartar" AutomationProperties.Name="Cantidad" Style="{StaticResource CampoInventario}" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera mayor a cero"/>
                                        <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding ErrorCantidad}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Style="{StaticResource EtiquetaInventario}" Content="_Motivo" Target="{Binding ElementName=MotivoApartar}"/>
                                        <TextBox x:Name="MotivoApartar" AutomationProperties.Name="Motivo" Style="{StaticResource CampoInventario}" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio"/>
                                        <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding ErrorMotivo}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Style="{StaticResource EstiloBotonPrimario}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Apartar prendas" Command="{Binding ApartarCommand}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding PanelReincorporarVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Text="Volver a dejar disponible para vender. Vuelve de apartado a disponible." Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <Label Style="{StaticResource EtiquetaInventario}" Content="_Cantidad" Target="{Binding ElementName=CantidadReincorporar}"/>
                                        <TextBox x:Name="CantidadReincorporar" AutomationProperties.Name="Cantidad" Style="{StaticResource CampoInventario}" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera mayor a cero"/>
                                        <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding ErrorCantidad}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Style="{StaticResource EtiquetaInventario}" Content="_Motivo" Target="{Binding ElementName=MotivoReincorporar}"/>
                                        <TextBox x:Name="MotivoReincorporar" AutomationProperties.Name="Motivo" Style="{StaticResource CampoInventario}" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio"/>
                                        <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding ErrorMotivo}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Style="{StaticResource EstiloBotonPrimario}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Reincorporar prendas" Command="{Binding ReincorporarCommand}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding PanelBajaVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Text="Retirar definitivamente del inventario. Reduce el físico: esas unidades dejan de existir." Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <Label Style="{StaticResource EtiquetaInventario}" Content="_Cantidad" Target="{Binding ElementName=CantidadBaja}"/>
                                        <TextBox x:Name="CantidadBaja" AutomationProperties.Name="Cantidad" Style="{StaticResource CampoInventario}" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera mayor a cero"/>
                                        <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding ErrorCantidad}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Label Style="{StaticResource EtiquetaInventario}" Content="_Motivo" Target="{Binding ElementName=MotivoBaja}"/>
                                        <TextBox x:Name="MotivoBaja" AutomationProperties.Name="Motivo" Style="{StaticResource CampoInventario}" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio"/>
                                        <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding ErrorMotivo}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource EstiloBotonDestructivo}" Content="Confirmar baja definitiva" Command="{Binding SolicitarBajaCommand}"/>
                                    <Button Style="{StaticResource EstiloBotonQuiet}" Content="Cancelar" Command="{Binding CancelarBajaCommand}"/>
                                </StackPanel>
                                <Border Margin="0,8,0,0" Padding="12" Background="{StaticResource Color.ErrorBgBrush}" BorderBrush="{StaticResource Color.ErrorTextBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding ConfirmacionBajaVisible, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource Color.ErrorTextBrush}" TextWrapping="Wrap" Text="¿Confirmás la baja definitiva? Esas unidades dejan de existir físicamente y no se puede deshacer desde esta pantalla."/>
                                        <Button Style="{StaticResource EstiloBotonDestructivo}" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Confirmar baja definitiva" Command="{Binding ConfirmarBajaCommand}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Margin="12,0,0,10" Padding="16" VerticalAlignment="Top">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Historial" FontSize="15"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Últimos movimientos de la variante"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300" Focusable="False">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Historial}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Ellipse Width="11" Height="11" Fill="{StaticResource Color.PrimaryBrush}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Tipo}"/>
                                                    <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Cantidad, StringFormat={}{0} u.}"/>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding CreadoEn, Converter={StaticResource FechaCorta}}"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Motivo}" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding ResponsableNombre, FallbackValue=—}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EstiloEstadoVacio}" Text="Todavía no hay movimientos para esta variante." Visibility="{Binding Historial.Count, Converter={StaticResource CeroVisible}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>
