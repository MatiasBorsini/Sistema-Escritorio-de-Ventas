<UserControl x:Class="LocalInfantil.Wpf.Views.ConfiguracionMercadoPagoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,12,20,16">
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Mercado Pago" />
            <TextBlock Style="{StaticResource EstiloAyuda}"
                       Text="Cobro con Point integrado. La credencial queda protegida en este equipo y nunca se muestra." />

            <Grid x:Name="LayoutConfiguracion">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3.8*" MinWidth="270" />
                    <ColumnDefinition Width="6.2*" MinWidth="430" />
                </Grid.ColumnDefinitions>

                <!-- Panel de apoyo visual; ilustración nativa, sin imagen ni dependencia externa. -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Style="{StaticResource EstiloTarjeta}" Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}"
                                       Text="CONFIGURACIÓN GUIADA" />
                            <Border Margin="0,12,0,12" Padding="14" Background="{StaticResource Color.Surface2Brush}"
                                    BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid Height="150">
                                    <Ellipse Width="132" Height="132" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{StaticResource Color.InfoBgBrush}" />
                                    <Border Width="104" Height="132" Padding="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{StaticResource Color.NavBrush}" CornerRadius="14">
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Height="72" Background="{StaticResource Color.SurfaceBrush}" CornerRadius="6">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"
                                                               Foreground="{StaticResource Color.PrimaryBrush}" Text="Point" />
                                                    <Border Width="38" Height="3" Margin="0,5,0,0"
                                                            Background="{StaticResource Color.BorderBrush}" CornerRadius="2" />
                                                </StackPanel>
                                            </Border>
                                            <Ellipse Width="20" Height="20" Margin="0,9,0,0" HorizontalAlignment="Center"
                                                     Fill="{StaticResource Color.AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}"
                                            BorderThickness="1" CornerRadius="12">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                                   Text="Cobro integrado" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"
                                       Text="Vinculá tu terminal Point" />
                            <TextBlock Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="Configurá la credencial y elegí una terminal para cobrar desde el sistema." />

                            <Border Margin="0,14,0,0" Height="1" Background="{StaticResource Color.BorderSoftBrush}" />
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource EstiloEtiqueta}" Text="Pasos rápidos" />
                            <StackPanel>
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <TextBlock Width="22" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="1." />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap" Text="Conectá una credencial válida." />
                                </StackPanel>
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <TextBlock Width="22" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="2." />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap" Text="Buscá y seleccioná una terminal." />
                                </StackPanel>
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <TextBlock Width="22" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="3." />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap" Text="Activá el modo integrado si hace falta." />
                                </StackPanel>
                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                    <TextBlock Width="22" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="4." />
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap" Text="Probá la conexión antes de cobrar." />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="12" Background="{StaticResource Color.WarningBgBrush}"
                            BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Importante" />
                            <TextBlock FontSize="12" Foreground="{StaticResource Color.WarningTextBrush}" TextWrapping="Wrap"
                                       Text="La configuración afecta cobros futuros. La credencial se protege en este equipo. Si la terminal no está en modo integrado, activalo antes de cobrar." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Configuración operativa existente: mismos datos, bindings y comandos. -->
                <StackPanel Grid.Column="1">
                    <Border x:Name="BloqueEstado" Style="{StaticResource EstiloTarjeta}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" FontSize="15" Text="Estado actual" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource EstiloEtiquetaMetrica}" Text="Estado" />
                                <Border Grid.Row="0" Grid.Column="1" Padding="7,2" HorizontalAlignment="Left" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Color.WarningBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Color.BorderSoftBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Conectado}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Color.SuccessBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Color.SuccessTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"
                                               Text="{Binding EstadoTexto}" />
                                </Border>
                                <TextBlock Grid.Row="1" Margin="0,7,0,0" Style="{StaticResource EstiloEtiquetaMetrica}" Text="Terminal" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,7,0,0">
                                    <TextBlock FontSize="13" Foreground="{StaticResource Color.TextBrush}" Text="{Binding TerminalTexto}" />
                                    <TextBlock FontSize="10" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                               Text="{Binding TerminalDetalle}" ToolTip="Identificador técnico para soporte" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" Margin="0,7,0,0" Style="{StaticResource EstiloEtiquetaMetrica}" Text="Modo" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,0,0" FontSize="13"
                                           Foreground="{StaticResource Color.TextBrush}" Text="{Binding ModoTexto}" />
                                <TextBlock Grid.Row="3" Margin="0,7,0,0" Style="{StaticResource EstiloEtiquetaMetrica}" Text="Sucursal/caja" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,0,0" FontSize="13"
                                           Foreground="{StaticResource Color.TextBrush}" Text="{Binding SucursalTexto}" />
                                <TextBlock Grid.Row="4" Margin="0,7,0,0" Style="{StaticResource EstiloEtiquetaMetrica}" Text="Última comprobación" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,7,0,0" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{StaticResource Color.TextBrush}" Text="{Binding UltimaComprobacionTexto}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="BloqueCredencial" Style="{StaticResource EstiloTarjeta}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" FontSize="15" Text="Credencial" />
                            <TextBlock Margin="0,2,0,6" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       Text="No se muestra en claro y queda protegida en este equipo." />
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Credencial de Mercado Pago" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="CajaCredencial" Grid.Column="0" MinHeight="34" Padding="8,4"
                                             VerticalContentAlignment="Center" BorderBrush="{StaticResource Color.BorderBrush}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,5"
                                        Style="{StaticResource EstiloBotonPrimario}" Content="Conectar / cambiar"
                                        Command="{Binding ConectarCommand}" />
                            </Grid>
                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       Text="Usá una credencial válida de Mercado Pago para esta instalación." />
                        </StackPanel>
                    </Border>

                    <Border x:Name="BloqueTerminal" Style="{StaticResource EstiloTarjeta}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" FontSize="15" Text="Terminal Point" />
                            <WrapPanel Margin="0,6,0,6">
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Buscar terminales"
                                        Command="{Binding BuscarTerminalesCommand}" />
                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Seleccionar"
                                        Command="{Binding SeleccionarCommand}" />
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Activar modo integrado"
                                        Command="{Binding ActivarModoCommand}" IsEnabled="{Binding PuedeActivarModo}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Terminal encontrada" />
                            <ComboBox Style="{StaticResource EstiloCombo}" ItemsSource="{Binding Terminales}"
                                      SelectedItem="{Binding TerminalSeleccionada}" DisplayMemberPath="Id" />
                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       TextWrapping="Wrap" Text="Si la terminal no está en modo integrado, activalo antes de cobrar." />
                        </StackPanel>
                    </Border>

                    <Border x:Name="BloqueAcciones" Style="{StaticResource EstiloTarjeta}" Margin="0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" FontSize="15" Text="Acciones" />
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Probar conexión"
                                        Command="{Binding ProbarCommand}" />
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Desconectar"
                                        Command="{Binding DesconectarCommand}" />
                            </StackPanel>
                            <Border Margin="0,8,0,0" Padding="9" Background="{StaticResource Color.SuccessBgBrush}"
                                    BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding Mensaje, Converter={StaticResource NullToVisibility}}">
                                <TextBlock FontSize="12" Foreground="{StaticResource Color.SuccessTextBrush}"
                                           TextWrapping="Wrap" Text="{Binding Mensaje}" />
                            </Border>
                            <Border Margin="0,6,0,0" Padding="9" Background="{StaticResource Color.ErrorBgBrush}"
                                    BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="4"
                                    Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                                <TextBlock FontSize="12" Foreground="{StaticResource Color.ErrorTextBrush}"
                                           TextWrapping="Wrap" Text="{Binding Error}" />
                            </Border>
                            <TextBlock Margin="0,8,0,0" FontSize="10" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       TextWrapping="Wrap" Text="{Binding TerminalDetalle}" ToolTip="Detalle técnico para soporte" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
