<UserControl x:Class="LocalInfantil.Wpf.Views.CuentaCorrienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,8">
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Cuenta corriente"/>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Saldo derivado de cargos, abonos y ajustes registrados."/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
        </StackPanel>
        <Grid Margin="20,0,20,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonSecundario}" Content="Consultar" Command="{Binding CargarCommand}"/>
                <views:BuscadorCliente x:Name="Buscador" Width="360" HorizontalAlignment="Left" Motor="{Binding MotorClientes}" SeleccionCommand="{Binding SeleccionarClienteCommand}"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Visibility="{Binding HayCliente, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Cliente.NombreCompleto}"/>
                                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Cliente.Telefono, TargetNullValue=Sin teléfono}"/>
                            </DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock FontSize="17" FontWeight="Bold" Foreground="{StaticResource Color.AccentBrush}" Text="{Binding Resumen.SaldoMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo: {0}'}" Margin="0,0,18,0"/>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Resumen.LimiteMinor, Converter={StaticResource MinorToArs}, TargetNullValue=No habilitado para fiado, StringFormat='Límite: {0}'}" Margin="0,0,18,0"/>
                                <TextBlock VerticalAlignment="Center" Text="{Binding Resumen.DisponibleMinor, Converter={StaticResource MinorToArs}, StringFormat='Disponible: {0}'}"/>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Registrar abono" Command="{Binding AbrirAbonoCommand}" Visibility="{Binding PuedeAbonar, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Ajustar deuda" Command="{Binding AbrirAjusteCommand}" Margin="8,0,0,0" Visibility="{Binding PuedeAjustar, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Buscá y seleccioná un cliente para consultar su cuenta." Foreground="{StaticResource Color.TextSecondaryBrush}" Visibility="{Binding HayCliente, Converter={StaticResource BoolToVisibilityInverted}}"/>
                        <DataGrid Style="{StaticResource EstiloGrillaOperativa}" ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Visibility="{Binding HayCliente, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130"/>
                                <DataGridTextColumn Header="Movimiento" Binding="{Binding Tipo}" Width="1.5*"/>
                                <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}" Width="*"/>
                                <DataGridTextColumn Header="Cargo" Binding="{Binding CargoMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                                <DataGridTextColumn Header="Abono" Binding="{Binding AbonoMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                                <DataGridTextColumn Header="Saldo" Binding="{Binding Movimiento.SaldoPosteriorMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Registrar abono" Visibility="{Binding FormularioAbono, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Visibility="{Binding FormularioAbono, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Importe total" Margin="0,6,0,2"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ImporteAbono, UpdateSourceTrigger=PropertyChanged}"/>
                            <ItemsControl ItemsSource="{Binding PagosAbono}" Margin="0,6">
                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.Medios, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Medio}"/><TextBox Grid.Column="1" Margin="4,0" Style="{StaticResource EstiloCampoTexto}" Text="{Binding ImporteTexto, UpdateSourceTrigger=PropertyChanged}"/><TextBox Grid.Column="2" Margin="4,0" Style="{StaticResource EstiloCampoTexto}" ToolTip="Efectivo recibido" Text="{Binding RecibidoTexto, UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="3" Content="−" Command="{Binding DataContext.QuitarPagoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal"><Button Style="{StaticResource EstiloBotonQuiet}" Content="+ Medio" Command="{Binding AgregarPagoCommand}"/><Button Style="{StaticResource EstiloBotonSecundario}" Content="Previsualizar aplicación" Command="{Binding PrevisualizarAbonoCommand}" Margin="6,0,0,0"/></StackPanel>
                            <ItemsControl ItemsSource="{Binding AplicacionesPrevias}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="{Binding Referencia}"/><TextBlock DockPanel.Dock="Right" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Margin="0,6" FontWeight="SemiBold" Text="{Binding PreviewAbono.SaldoAnteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo anterior: {0}'}"/>
                            <TextBlock FontWeight="SemiBold" Text="{Binding PreviewAbono.SaldoPosteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo posterior: {0}'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar abono" Command="{Binding ConfirmarAbonoCommand}" IsEnabled="{Binding PuedeConfirmarAbono}"/><Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarFormularioCommand}" Margin="8,0,0,0"/></StackPanel>
                        </StackPanel>
                        <Separator Margin="0,10" Visibility="{Binding FormularioAjuste, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Ajuste manual de deuda" Visibility="{Binding FormularioAjuste, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Visibility="{Binding FormularioAjuste, Converter={StaticResource BoolToVisibility}}">
                            <ComboBox SelectedIndex="{Binding AjusteTipoIndex}" Margin="0,6"><ComboBoxItem Content="Aumentar deuda"/><ComboBoxItem Content="Reducir deuda"/></ComboBox>
                            <TextBlock Text="Importe"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ImporteAjuste, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Motivo obligatorio" Margin="0,4,0,0"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding MotivoAjuste, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="Previsualizar ajuste" Command="{Binding PrevisualizarAjusteCommand}" Margin="0,6,0,0"/>
                            <TextBlock Margin="0,6" Text="{Binding PreviewAjuste.SaldoAnteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo anterior: {0}'}"/>
                            <TextBlock Text="{Binding PreviewAjuste.ImporteFirmadoMinor, Converter={StaticResource MinorToArs}, StringFormat='Ajuste: {0}'}"/>
                            <TextBlock Text="{Binding PreviewAjuste.SaldoPosteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo posterior: {0}'}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar ajuste" Command="{Binding ConfirmarAjusteCommand}"/><Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarFormularioCommand}" Margin="8,0,0,0"/></StackPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding PuedeConfigurarLimite, Converter={StaticResource BoolToVisibility}}">
                            <Separator Margin="0,10"/><TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Límite de crédito"/><TextBlock Text="Vacío = no habilitado para fiado" Foreground="{StaticResource Color.TextSecondaryBrush}"/><DockPanel Margin="0,4,0,0"><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding LimiteTexto, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Guardar" Command="{Binding GuardarLimiteCommand}" Margin="6,0,0,0"/></DockPanel>
                        </StackPanel>
                        <Button Margin="0,8,0,0" Style="{StaticResource EstiloBotonQuiet}" Content="Ver último recibo de abono" Click="AbrirUltimoAbono_Click" Visibility="{Binding UltimoAbonoId, Converter={StaticResource NullToVisibility}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
