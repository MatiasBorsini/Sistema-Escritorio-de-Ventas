<UserControl x:Class="LocalInfantil.Wpf.Views.CuentaCorrienteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views">
    <UserControl.Resources>
        <FontFamily x:Key="FuenteIcono">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>

    <Grid Background="{StaticResource Color.CanvasBrush}" Margin="20,10,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado compacto -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
            <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="20" Foreground="{StaticResource Color.PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,9,0" Text="&#xE7C1;"/>
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Cuenta corriente"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="65*"/>
            </Grid.ColumnDefinitions>

            <!-- IZQUIERDA: cartera paginada y filtros -->
            <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Clientes y estado de cuenta" Margin="0,0,0,6"/>
                        <TextBox x:Name="BusquedaCuentaTextBox" Style="{StaticResource EstiloCampoTexto}" Text="{Binding TextoCliente, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Buscar por nombre o teléfono" AutomationProperties.Name="Buscar cliente por nombre o teléfono"/>
                        <ComboBox x:Name="FiltroClientesCuentaComboBox" Margin="0,7,0,0" SelectedIndex="{Binding FiltroClientesIndice}" AutomationProperties.Name="Filtrar clientes de cuenta corriente">
                            <ComboBoxItem Content="Con cuenta o deuda"/>
                            <ComboBoxItem Content="Con deuda pendiente"/>
                            <ComboBoxItem Content="Fiado habilitado"/>
                            <ComboBoxItem Content="Todos los clientes"/>
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                    <DataGrid x:Name="ClientesCuentaDataGrid" ItemsSource="{Binding Clientes}"
                              SelectedItem="{Binding ClienteListadoSeleccionado, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionUnit="FullRow" SelectionMode="Single" HeadersVisibility="None"
                              Style="{StaticResource EstiloGrillaOperativa}" AutomationProperties.Name="Clientes y saldo de cuenta corriente">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NombreCompleto}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Telefono, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Estado, Mode=OneWay}"/>
                                                    </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Text="{Binding SaldoMinor, Converter={StaticResource MinorToArs}}" FontWeight="SemiBold"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="220" TextAlignment="Center"
                               Text="No hay clientes para estos filtros." Foreground="{StaticResource Color.TextSecondaryBrush}"
                               Visibility="{Binding SinClientesListado, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False"/>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="0,6,0,0">
                        <ProgressBar DockPanel.Dock="Left" Style="{StaticResource EstiloOcupado}" Width="72" Height="4" VerticalAlignment="Center"
                                     Visibility="{Binding OcupadoListado, Converter={StaticResource BoolToVisibility}}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonQuiet}" Content="Siguiente" Command="{Binding ClientesPaginaSiguienteCommand}" IsEnabled="{Binding HayMasClientes}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonQuiet}" Content="Anterior" Command="{Binding ClientesPaginaAnteriorCommand}" IsEnabled="{Binding PuedePaginaAnterior}"/>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TextoPaginaClientes}" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- DERECHA: ficha + historial + formularios -->
            <Border Grid.Column="2" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                <Grid>
                    <!-- Estado vacío compacto -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                                Visibility="{Binding HayCliente, Converter={StaticResource BoolToVisibilityInverted}}">
                        <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource Color.BorderSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="19" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       Text="&#xE7C1;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                   Text="Seleccioná un cliente para ver su cuenta corriente."/>
                    </StackPanel>

                    <!-- Con cliente seleccionado -->
                    <DockPanel Visibility="{Binding HayCliente, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Top">
                            <!-- Ficha compacta -->
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Color.BorderSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="16" Foreground="{StaticResource Color.PrimaryBrush}"
                                               Text="&#xE77B;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Cliente.NombreCompleto}"/>
                                    <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Cliente.Telefono, TargetNullValue=Sin teléfono}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Margin="0,8,0,0" Padding="9" Background="{StaticResource Color.WarningBgBrush}" CornerRadius="6"
                                    Visibility="{Binding ConfirmacionCambioClienteVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Color.WarningTextBrush}" TextWrapping="Wrap"
                                               Text="Hay una operación o un límite editado sin guardar. ¿Querés descartarlo para cambiar de cliente?"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Descartar y cambiar cliente" Command="{Binding ConfirmarCambioClienteCommand}"/>
                                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="Seguir con este cliente" Command="{Binding CancelarCambioClienteCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,8,0,0" Padding="9" Background="{StaticResource Color.WarningBgBrush}" CornerRadius="6"
                                    Visibility="{Binding ConfirmacionCambioOperacionVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Color.WarningTextBrush}" Text="La operación actual tiene datos sin guardar. ¿Descartarlos y abrir la otra operación?" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Descartar y continuar" Command="{Binding ConfirmarCambioOperacionCommand}"/>
                                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="Seguir editando" Command="{Binding CancelarCambioOperacionCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Saldo pendiente" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Color.AccentBrush}"
                                               Text="{Binding Resumen.SaldoMinor, Converter={StaticResource MinorToArs}, TargetNullValue=—}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="Límite autorizado" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Resumen.LimiteMinor, Converter={StaticResource MinorToArs}, TargetNullValue=Fiado no habilitado}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                    <TextBlock Text="Crédito disponible" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Resumen.DisponibleMinor, Converter={StaticResource MinorToArs}, TargetNullValue=—}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Acciones principales -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Registrar abono" Command="{Binding AbrirAbonoCommand}" IsEnabled="{Binding PuedeRegistrarAbono}"
                                        Visibility="{Binding PuedeAbonar, Converter={StaticResource BoolToVisibility}}"/>
                                <Button x:Name="AjustarDeudaButton" Style="{StaticResource EstiloBotonSecundario}" Content="Ajustar deuda" Command="{Binding AbrirAjusteCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding PuedeAjustarCuenta, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Editar límite"
                                        Command="{Binding AbrirEdicionLimiteCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding PuedeEditarLimiteActual, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Habilitar venta a cuenta"
                                        Command="{Binding AbrirEdicionLimiteCommand}" Margin="8,0,0,0"
                                        Visibility="{Binding PuedeHabilitarFiado, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource EstiloBotonQuiet}" Content="Ver último recibo de abono" Margin="12,0,0,0" Click="AbrirUltimoAbono_Click"
                                        Visibility="{Binding UltimoAbonoId, Converter={StaticResource NullToVisibility}}"/>
                            </StackPanel>

                            <!-- Formulario de abono (sólo cuando se lo pide) -->
                            <Border Margin="0,8,0,0" Padding="10" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Visibility="{Binding FormularioAbono, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Registrar abono"/>
                                    <TextBlock Text="Importe total" Margin="0,6,0,2"/>
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ImporteAbono, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ItemsControl ItemsSource="{Binding PagosAbono}" Margin="0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding DataContext.Medios, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Medio}"/>
                                                    <TextBox Grid.Column="1" Margin="4,0" Style="{StaticResource EstiloCampoTexto}" Text="{Binding ImporteTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBox Grid.Column="2" Margin="4,0" Style="{StaticResource EstiloCampoTexto}" ToolTip="Efectivo recibido" Text="{Binding RecibidoTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Grid.Column="3" Content="−" Command="{Binding DataContext.QuitarPagoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="+ Medio" Command="{Binding AgregarPagoCommand}"/>
                                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Previsualizar aplicación" Command="{Binding PrevisualizarAbonoCommand}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding AplicacionesPrevias}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock Text="{Binding Referencia}"/>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="0,6" FontWeight="SemiBold" Text="{Binding PreviewAbono.SaldoAnteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo anterior: {0}'}"/>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding PreviewAbono.SaldoPosteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo posterior: {0}'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar abono" Command="{Binding ConfirmarAbonoCommand}" IsEnabled="{Binding PuedeConfirmarAbono}"/>
                                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarFormularioCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Formulario de ajuste (sólo cuando se lo pide) -->
                            <Border Margin="0,8,0,0" Padding="10" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="6"
                                    Visibility="{Binding FormularioAjuste, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Ajuste manual de deuda"/>
                                    <ComboBox SelectedIndex="{Binding AjusteTipoIndex}" Margin="0,6">
                                        <ComboBoxItem Content="Aumentar deuda"/><ComboBoxItem Content="Reducir deuda"/>
                                    </ComboBox>
                                    <TextBlock Text="Importe"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ImporteAjuste, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Motivo obligatorio" Margin="0,4,0,0"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding MotivoAjuste, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Previsualizar ajuste" Command="{Binding PrevisualizarAjusteCommand}" Margin="0,6,0,0"/>
                                    <TextBlock Margin="0,6" Text="{Binding PreviewAjuste.SaldoAnteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo anterior: {0}'}"/>
                                    <TextBlock Text="{Binding PreviewAjuste.ImporteFirmadoMinor, Converter={StaticResource MinorToArs}, StringFormat='Ajuste: {0}'}"/>
                                    <TextBlock Text="{Binding PreviewAjuste.SaldoPosteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo posterior: {0}'}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar ajuste" Command="{Binding ConfirmarAjusteCommand}"/>
                                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarFormularioCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Edición de límite: acción explícita -->
                            <Border Margin="0,8,0,0" Padding="10" Background="{StaticResource Color.Surface2Brush}" CornerRadius="6"
                                    Visibility="{Binding EdicionLimiteVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonQuiet}" Content="Cancelar" Command="{Binding CerrarEdicionLimiteCommand}"/>
                                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Límite de crédito" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="El límite autoriza nuevas ventas a cuenta; no es dinero disponible en caja." Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,2,0,4" TextWrapping="Wrap"/>
                                    <TextBlock Text="Para habilitar el fiado, ingresá un límite mayor que cero." Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,0,0,4"
                                               Visibility="{Binding NoHabilitadoFiado, Converter={StaticResource BoolToVisibility}}"/>
                                    <TextBlock Text="Límite autorizado (ARS)" Margin="0,2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="140" Style="{StaticResource EstiloCampoTexto}" Text="{Binding LimiteTexto, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Continuar" Command="{Binding GuardarLimiteCommand}" Margin="6,0,0,0"/>
                                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Deshabilitar nuevas ventas a cuenta"
                                                Command="{Binding DeshabilitarFiadoCommand}" Margin="8,0,0,0"
                                                Visibility="{Binding PuedeEditarLimiteActual, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <Border Margin="0,7,0,0" Padding="8" Background="{StaticResource Color.WarningBgBrush}" CornerRadius="5"
                                            Visibility="{Binding ConfirmacionHabilitarFiadoVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Vas a autorizar nuevas ventas a cuenta hasta el límite indicado. La deuda existente no cambia." TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar habilitación" Command="{Binding ConfirmarHabilitarFiadoCommand}"/>
                                                <Button Style="{StaticResource EstiloBotonQuiet}" Content="Volver" Command="{Binding CancelarConfirmacionHabilitarCommand}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,7,0,0" Padding="8" Background="{StaticResource Color.WarningBgBrush}" CornerRadius="5"
                                            Visibility="{Binding ConfirmacionDeshabilitarFiadoVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Se bloquearán nuevas ventas a cuenta. La deuda y los movimientos anteriores se conservarán." TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar deshabilitación" Command="{Binding ConfirmarDeshabilitarFiadoCommand}"/>
                                                <Button Style="{StaticResource EstiloBotonQuiet}" Content="Volver" Command="{Binding CancelarConfirmacionDeshabilitarCommand}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Movimientos: ocupan el resto, scroll interno propio -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource EstiloEtiqueta}" Text="Movimientos" Margin="0,12,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,0,0,6"
                                       Text="Sin movimientos todavía." Visibility="{Binding Movimientos.Count, Converter={StaticResource CeroVisible}}"/>
                            <DataGrid Style="{StaticResource EstiloGrillaOperativa}" ItemsSource="{Binding Movimientos}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130"/>
                                    <DataGridTextColumn Header="Movimiento" Binding="{Binding Tipo}" Width="1.5*"/>
                                    <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}" Width="*"/>
                                    <DataGridTextColumn Header="Cargo" Binding="{Binding CargoMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                                    <DataGridTextColumn Header="Abono" Binding="{Binding AbonoMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                                    <DataGridTextColumn Header="Saldo" Binding="{Binding Movimiento.SaldoPosteriorMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
