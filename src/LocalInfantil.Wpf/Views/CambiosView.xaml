<UserControl x:Class="LocalInfantil.Wpf.Views.CambiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,6">
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Cambios y devoluciones"/>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Buscá la venta original, seleccioná prendas y registrá la diferencia. Comprobante interno no fiscal."/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
        </StackPanel>
        <Grid Margin="20,0,20,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34*"/><ColumnDefinition Width="66*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,0,10,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="BUSCAR VENTA · NÚMERO, PRODUCTO O CÓDIGO"/>
                        <DockPanel Margin="0,4,0,5"><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"/><Button Style="{StaticResource EstiloBotonPrimario}" Content="Buscar" Command="{Binding BuscarCommand}" Margin="6,0,0,0"/></DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7"><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Desde"/><DatePicker Width="125" SelectedDate="{Binding Desde}" Margin="4,0,8,0"/><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Hasta"/><DatePicker Width="125" SelectedDate="{Binding Hasta}" Margin="4,0"/></StackPanel>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Ventas}" SelectedItem="{Binding Venta}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Foreground="{StaticResource Color.TextBrush}" FontWeight="SemiBold" Text="{Binding Resumen.Numero}"/><TextBlock FontSize="10" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding AntiguedadTexto}"/></StackPanel><TextBlock Grid.Column="1" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding FechaTexto}"/><TextBlock Grid.Column="2" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Resumen.TotalMinor, Converter={StaticResource MinorToArs}}"/></Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                        <StackPanel>
                            <DockPanel><TextBlock Style="{StaticResource EstiloEtiqueta}" Text="PRENDAS DE LA VENTA ORIGINAL"/><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Solo unidades aún no devueltas"/></DockPanel>
                            <DataGrid ItemsSource="{Binding Entradas}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="False" MinHeight="105" MaxHeight="220" Margin="0,5,0,8">
                                <DataGrid.Columns><DataGridTextColumn Header="Artículo" Binding="{Binding Descripcion}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="Disp." Binding="{Binding Item.CantidadDisponible}" Width="55" IsReadOnly="True"/><DataGridTextColumn Header="Dev. cant." Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="70"/><DataGridCheckBoxColumn Header="Apta" Binding="{Binding Apta}" Width="55"/><DataGridTextColumn Header="Motivo no apta" Binding="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="ARTÍCULOS NUEVOS"/>
                            <DockPanel Margin="0,4,0,5"><TextBox Style="{StaticResource EstiloCampoTexto}" Width="150" Text="{Binding CodigoSalida, UpdateSourceTrigger=PropertyChanged}" ToolTip="Código interno exacto"/><TextBox Style="{StaticResource EstiloCampoTexto}" Width="65" Margin="5,0" Text="{Binding CantidadSalida}"/><Button Style="{StaticResource EstiloBotonSecundario}" Content="Agregar" Command="{Binding AgregarSalidaCommand}"/></DockPanel>
                            <ItemsControl ItemsSource="{Binding Salidas}" Margin="0,0,0,5"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="2"><TextBlock Foreground="{StaticResource Color.TextBrush}" Text="{Binding Descripcion}"/><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Color.TextBrush}" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <DockPanel><TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="{Binding DiferenciaTexto}"/><Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonPrimario}" Content="Registrar cambio" IsEnabled="{Binding PuedeRegistrar}" Click="Confirmar_Click"/></DockPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="COBRO / REINTEGRO Y CAJA"/>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Para diferencia a cobrar, cargá formas de pago que sumen el total exacto." TextWrapping="Wrap"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource EstiloBotonQuiet}" Content="+ Agregar forma de pago" Command="{Binding AgregarPagoCommand}"/>
                            <ItemsControl ItemsSource="{Binding Pagos}"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><ComboBox Width="140" ItemsSource="{Binding DataContext.Medios, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Medio}"/><TextBox Width="100" Margin="5,0" Text="{Binding ImporteMinor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Importe en centavos"/><TextBox Width="100" Text="{Binding RecibidoMinor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Recibido en efectivo, centavos"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <DockPanel Margin="0,6,0,0"><TextBlock VerticalAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Medio del reintegro (efectivo por defecto)"/><ComboBox Width="150" Margin="8,0" ItemsSource="{Binding Medios}" SelectedItem="{Binding MedioReintegro}"/></DockPanel>
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Margin="0,5,0,0" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo obligatorio para reintegro"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding RequiereAutorizacionPresencial, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0">
                                <TextBox Style="{StaticResource EstiloCampoTexto}" Width="160" Text="{Binding UsuarioAutorizante}" ToolTip="Usuario Dueña presente"/>
                                <PasswordBox x:Name="ContrasenaDuena" Width="160" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,8,0,0">
                        <StackPanel><TextBlock Style="{StaticResource EstiloEtiqueta}" Text="HISTORIAL DE CAMBIOS · DOBLE CLIC PARA VER COMPROBANTE"/><ItemsControl ItemsSource="{Binding Historial}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="2" MouseLeftButtonDown="HistorialItem_MouseLeftButtonDown"><DockPanel Margin="1,4"><TextBlock Foreground="{StaticResource Color.TextBrush}" Text="{Binding Numero}"/><TextBlock Margin="8,0" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Fecha, Converter={StaticResource FechaCorta}}"/><TextBlock DockPanel.Dock="Right" Foreground="{StaticResource Color.TextBrush}" Text="{Binding DiferenciaMinor, Converter={StaticResource MinorToArs}}"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
