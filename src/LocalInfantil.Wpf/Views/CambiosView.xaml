<UserControl x:Class="LocalInfantil.Wpf.Views.CambiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views">
    <UserControl.Resources>
        <!-- Grilla de prendas: filas ~40 y encabezados 32, sobre el estilo operativo -->
        <Style x:Key="EstiloGrillaCambios" TargetType="DataGrid" BasedOn="{StaticResource EstiloGrillaOperativa}">
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>
        <!-- Cantidad compacta: 30 DIP de alto, sin márgenes verticales de sobra -->
        <Style x:Key="EstiloCantidadCorta" TargetType="TextBox" BasedOn="{StaticResource EstiloCampoTexto}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CantidadExcedeDisponible}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Color.ErrorTextBrush}"/>
                    <Setter Property="Background" Value="{StaticResource Color.ErrorBgBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="18,10,18,8">
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Cambios y devoluciones"/>
            <TextBlock Style="{StaticResource EstiloAyuda}" Margin="0,2,0,6" Text="Buscá la venta, elegí qué vuelve y qué se lleva. Comprobante interno no fiscal."/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Margin="18,0,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28*" MinWidth="260"/>
                <ColumnDefinition Width="72*" MinWidth="500"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,0,10,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="BUSCAR VENTA"/>
                        <TextBlock Style="{StaticResource EstiloAyuda}" Margin="0,2,0,8" Text="Número de ticket, producto o código. Se filtra mientras escribís." TextWrapping="Wrap"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonPrimario}" Content="Buscar" Click="BuscarVentas_Click" Margin="6,0,0,0"/>
                            <TextBox x:Name="BuscarVentaTextBox" Style="{StaticResource EstiloCampoTexto}" Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}" ToolTip="Número de ticket, producto o código" KeyDown="BuscarVentaTextBox_KeyDown"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Desde"/><DatePicker SelectedDate="{Binding Desde}" HorizontalAlignment="Stretch"/></StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Hasta"/><DatePicker SelectedDate="{Binding Hasta}" HorizontalAlignment="Stretch"/></StackPanel>
                        </Grid>
                        <ProgressBar Style="{StaticResource EstiloOcupado}" Height="3" Margin="0,0,0,4"
                                     Visibility="{Binding BuscandoVentas, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <ListBox x:Name="VentasListBox" ItemsSource="{Binding Ventas}"
                             IsEnabled="{Binding PuedeSeleccionarVenta}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="VentasListBox_PreviewKeyDown"
                             SelectionChanged="VentasListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Anulada}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Opacity" Value="0.58"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Numero}"/>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource Color.TextBrush}" Text="{Binding TotalTexto}"/>
                                    <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding FechaTexto}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right" FontSize="12" Text="{Binding EstadoTexto}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Color.SuccessTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Anulada}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Color.ErrorTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,0,0,8">
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="VENTA SELECCIONADA"/>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"
                                       Text="{Binding VentaContexto}" Visibility="{Binding Venta, Converter={StaticResource NullToVisibility}}"/>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Buscá y seleccioná una venta para comenzar."
                                       Visibility="{Binding SinVentaSeleccionada, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource Color.ErrorTextBrush}" Text="VENTA ANULADA · NO ADMITE CAMBIOS"
                                   Visibility="{Binding VentaAnulada, Converter={StaticResource BoolToVisibility}}"/>
                    </DockPanel>
                </Border>

                <TabControl Grid.Row="1" SelectedValue="{Binding SeccionActiva}" SelectedValuePath="Tag" IsEnabled="{Binding PuedeConsultar}">
                    <TabItem Header="Operación" Tag="operacion">
                        <Grid Margin="4,6,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="4,0,4,10">
                                <TextBlock Text="Tipo de operación" Style="{StaticResource EstiloEtiqueta}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <RadioButton Content="Cambio" IsChecked="{Binding EsModoCambio, Mode=TwoWay}" GroupName="ModoCambioDevolucion" Margin="0,0,16,0"/>
                                <RadioButton Content="Devolución" IsChecked="{Binding EsModoDevolucion, Mode=TwoWay}" GroupName="ModoCambioDevolucion"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="4,4">
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}"
                                           Text="{Binding EstadoVacioOperacion}" TextWrapping="Wrap"
                                           Visibility="{Binding MostrarEstadoVacioOperacion, Converter={StaticResource BoolToVisibility}}"/>
                                <StackPanel Visibility="{Binding CargandoDetalle, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource EstiloAyuda}" Margin="0" Text="Cargando el detalle de la venta..."/>
                                    <ProgressBar Style="{StaticResource EstiloOcupado}" Height="3" Margin="0,4,0,0" IsIndeterminate="True"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Prendas que vuelven: grilla con scroll propio -->
                            <Border Grid.Row="2" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}"
                                    IsEnabled="{Binding PuedeEditarOperacion}"
                                    Visibility="{Binding MostrarOperacion, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="PRENDAS QUE VUELVEN"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource EstiloAyuda}" Margin="10,0,0,2" Text="Solo unidades aún no devueltas; «Máximo» no es el stock actual"/>
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Color.ErrorTextBrush}"
                                               Text="{Binding ErrorCantidadesTexto}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ErrorCantidadesTexto}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <DataGrid x:Name="EntradasDataGrid" ItemsSource="{Binding Entradas}" AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" Margin="0,4"
                                              Style="{StaticResource EstiloGrillaCambios}"
                                              IsReadOnly="False" HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Artículo" Binding="{Binding Descripcion}" Width="2.6*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Máximo" Binding="{Binding Item.CantidadDisponible}" Width="86" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Cantidad" Width="112">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="3,1">
                                                            <TextBox Style="{StaticResource EstiloCantidadCorta}" MinWidth="64"
                                                                     Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="{Binding ErrorCantidad}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Apta" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding Apta}"
                                                                  ToolTip="Apta para volver a vender. Desmarcá si vuelve no apta: se exigirá el motivo."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Motivo" Width="1.3*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Margin="3,1" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"
                                                                 ToolTip="Obligatorio si la prenda vuelve no apta">
                                                            <TextBox.Style>
                                                                <Style TargetType="TextBox" BasedOn="{StaticResource EstiloCampoTexto}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers><DataTrigger Binding="{Binding Apta}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <!-- Artículos nuevos (sólo modo cambio) -->
                            <Border Grid.Row="3" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,8,0,0"
                                    Visibility="{Binding EsModoCambio, Converter={StaticResource BoolToVisibility}}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="ARTÍCULOS NUEVOS"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource EstiloAyuda}" Margin="10,0,0,2" Text="Buscá por nombre o código; elegí una sugerencia."/>
                                    </Grid>
                                    <StackPanel>
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <views:BuscadorAsistido x:Name="BuscadorArticulo" Modo="VarianteStock"
                                                                    Motor="{Binding MotorArticulos}"
                                                                    SeleccionCommand="{Binding SeleccionarArticuloCommand}"
                                                                    TextoSeleccionado="{Binding TextoArticuloPresentacion}"
                                                                    EnfocarAlLimpiarMotor="True"
                                                                    BusquedaDirectaCommand="{Binding AgregarSalidaDirectaCommand}"
                                                                    PatronCodigoExactoEnEnter="^[A-Za-z]{2,5}-[0-9]{3}-[A-Za-z0-9-]+$"
                                                                    AutomationProperties.Name="Buscar artículo nuevo"
                                                                    Placeholder="Nombre, SKU o código..."
                                                                    ToolTip="Elegí una sugerencia; el botón Agregar valida cantidad, stock y precio"/>
                                            <TextBox Grid.Column="1" Style="{StaticResource EstiloCampoTexto}" Margin="6,0"
                                                     Text="{Binding CantidadSalida, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad"/>
                                            <Button Grid.Column="2" Style="{StaticResource EstiloBotonSecundario}" Content="Agregar" Command="{Binding AgregarSalidaCommand}" IsEnabled="{Binding PuedeAgregarArticulo}"/>
                                        </Grid>
                                        <TextBlock Margin="2,0,0,3" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                                   Text="{Binding ArticuloSeleccionadoDetalle}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding TieneArticuloSeleccionado, Converter={StaticResource BoolToVisibility}}"/>
                                        <ItemsControl ItemsSource="{Binding Salidas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="1,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/><ColumnDefinition Width="95"/><ColumnDefinition Width="95"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Descripcion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Cantidad, StringFormat=Cant. {0}}"/>
                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                                                   Text="{Binding Opcion.PrecioMinor, Converter={StaticResource MinorToArs}}" ToolTip="Precio vigente unitario"/>
                                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource Color.TextBrush}" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/>
                                                        <Button Grid.Column="4" Margin="7,0,0,0" Style="{StaticResource EstiloBotonQuiet}" Content="Quitar"
                                                                Command="{Binding DataContext.QuitarSalidaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" ToolTip="Quitar este artículo de la operación"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- Reintegro Mercado Pago pendiente -->
                            <Border Grid.Row="4" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,8,0,0"
                                    Visibility="{Binding ReintegroMpPendienteVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource Color.WarningTextBrush}" Text="{Binding ReintegroMpPendienteTexto}" TextWrapping="Wrap"/>
                                    <Button Margin="0,6,0,0" HorizontalAlignment="Left" Style="{StaticResource EstiloBotonSecundario}"
                                            Content="Reembolsar en Mercado Pago" Command="{Binding ReembolsarMpCommand}"
                                            IsEnabled="{Binding PuedeReembolsarMp}"/>
                                </StackPanel>
                            </Border>

                            <!-- Resumen económico + Continuar: fijos en pantalla -->
                            <Border Grid.Row="5" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,10,0,0"
                                    Visibility="{Binding MostrarOperacion, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Crédito por prendas devueltas"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource Color.TextBrush}" Text="{Binding CreditoEntradasTexto}"/>
                                        <TextBlock Grid.Row="1" Margin="0,2,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Total de artículos nuevos"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,2,0,0" HorizontalAlignment="Right" Foreground="{StaticResource Color.TextBrush}" Text="{Binding TotalSalidasTexto}"/>
                                        <TextBlock Grid.Row="2" Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Diferencia"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,3,0,0" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource Color.PrimaryBrush}" Text="{Binding ResultadoDiferenciaTexto}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultadoDiferenciaTexto}"/>
                                    </Grid>
                                    <Button Grid.Column="1" MinWidth="142" Style="{StaticResource EstiloBotonPrimario}" Content="Continuar"
                                            IsEnabled="{Binding PuedeContinuarOperacion}" Click="Continuar_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Historial" Tag="historial">
                        <Grid Margin="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Top" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       Text="Seleccioná una venta para ver su historial de cambios."
                                       Visibility="{Binding SinVentaSeleccionada, Converter={StaticResource BoolToVisibility}}"/>
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding Venta, Converter={StaticResource NullToVisibility}}">
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Cambios y devoluciones registrados"/>
                                <TextBlock Style="{StaticResource EstiloAyuda}" Text="{Binding VentaContexto}" Margin="0,4,0,2"/>
                                <TextBlock Style="{StaticResource EstiloAyuda}" Text="Doble clic sobre una fila para abrir e imprimir el comprobante."/>
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Esta venta todavía no tiene cambios registrados."
                                           Margin="0,10,0,0"
                                           Visibility="{Binding HistorialVacio, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <DataGrid x:Name="HistorialDataGrid" Grid.Row="1" ItemsSource="{Binding Historial}" Style="{StaticResource EstiloGrillaCambios}"
                                      Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}"
                                      IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                                      EnableRowVirtualization="True" Visibility="{Binding HistorialVacio, Converter={StaticResource BoolToVisibilityInverted}}"
                                      MouseDoubleClick="HistorialListBox_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Comprobante" Binding="{Binding Numero}" Width="1*" MinWidth="95"/>
                                    <DataGridTextColumn Header="Fecha / hora" Binding="{Binding Fecha, Converter={StaticResource FechaCorta}}" Width="1.15*" MinWidth="105"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding TipoTexto}" Width="1*" MinWidth="92"/>
                                    <DataGridTextColumn Header="Venta original" Binding="{Binding VentaNumero}" Width="1*" MinWidth="95"/>
                                    <DataGridTextColumn Header="Resultado" Binding="{Binding ResultadoTexto}" Width="1.25*" MinWidth="112"/>
                                    <DataGridTextColumn Header="Importe" Binding="{Binding ImporteResultadoMinor, Converter={StaticResource MinorToArs}}" Width="1.25*" MinWidth="112">
                                        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="Margin" Value="6,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Responsable" Binding="{Binding Responsable}" Width="1*" MinWidth="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
