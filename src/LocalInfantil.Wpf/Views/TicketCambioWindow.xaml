<Window x:Class="LocalInfantil.Wpf.Views.TicketCambioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprobante interno de cambio" Width="460" Height="620" WindowStartupLocation="CenterOwner" Background="White">
    <DockPanel Margin="18">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,7" Content="Imprimir…" Click="Imprimir_Click"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Documento" Margin="20" Background="White">
                <TextBlock FontSize="20" FontWeight="Bold" Text="LocalInfantil" TextAlignment="Center"/>
                <TextBlock Margin="0,3,0,12" FontSize="12" FontWeight="Bold" Text="COMPROBANTE INTERNO — NO FISCAL" TextAlignment="Center"/>
                <TextBlock FontWeight="Bold" Text="{Binding Numero, StringFormat='Cambio {0}'}"/>
                <TextBlock Text="{Binding VentaNumero, StringFormat='Venta original: {0}'}"/>
                <TextBlock Text="{Binding Fecha, Converter={StaticResource FechaCorta}}"/>
                <TextBlock Text="{Binding Responsable, StringFormat=Responsable: {0}}"/>
                <TextBlock Text="{Binding Autorizante, StringFormat=Autorización presencial: {0}}"/>
                <Separator Margin="0,8"/>
                <ItemsControl ItemsSource="{Binding Lineas}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,3">
                            <DockPanel><TextBlock FontWeight="SemiBold" Text="{Binding Direccion}"/><TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
                            <TextBlock Text="{Binding NombreProducto}" TextWrapping="Wrap"/>
                            <TextBlock FontSize="11" Text="{Binding CodigoInterno}"/>
                            <TextBlock FontSize="11" Text="{Binding Cantidad, StringFormat=Cantidad: {0}}"/>
                            <TextBlock FontSize="11" Text="{Binding MotivoNoApta, StringFormat=No apta: {0}}"/>
                        </StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <Separator Margin="0,8"/>
                <DockPanel><TextBlock Text="Valor reconocido"/><TextBlock DockPanel.Dock="Right" Text="{Binding ImporteEntradasMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
                <DockPanel><TextBlock Text="Artículos nuevos"/><TextBlock DockPanel.Dock="Right" Text="{Binding ImporteSalidasMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
                <DockPanel Margin="0,4"><TextBlock FontSize="16" FontWeight="Bold" Text="Diferencia"/><TextBlock DockPanel.Dock="Right" FontSize="16" FontWeight="Bold" Text="{Binding DiferenciaMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
                <StackPanel Margin="0,4" Visibility="{Binding DecisionCuenta, Converter={StaticResource NullToVisibility}}">
                    <TextBlock FontWeight="SemiBold" Text="{Binding DecisionCuentaTexto}" TextWrapping="Wrap"/>
                    <DockPanel><TextBlock Text="Crédito aplicado a deuda"/><TextBlock DockPanel.Dock="Right" Text="{Binding ImporteAplicadoDeudaMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
                    <DockPanel><TextBlock Text="Deuda antes"/><TextBlock DockPanel.Dock="Right" Text="{Binding DeudaAnteriorMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
                    <DockPanel><TextBlock Text="Deuda después"/><TextBlock DockPanel.Dock="Right" Text="{Binding DeudaPosteriorMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Pagos}" Margin="0,5">
                    <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><DockPanel><TextBlock Text="{Binding Direccion}"/><TextBlock Margin="6,0" Text="{Binding Medio}"/><TextBlock DockPanel.Dock="Right" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/></DockPanel><DockPanel><TextBlock Text="Recibido en efectivo" Visibility="{Binding RecibidoMinor, Converter={StaticResource NullToVisibility}}"/><TextBlock DockPanel.Dock="Right" Text="{Binding RecibidoMinor, Converter={StaticResource MinorToArs}}" Visibility="{Binding RecibidoMinor, Converter={StaticResource NullToVisibility}}"/></DockPanel><DockPanel><TextBlock Text="Vuelto" Visibility="{Binding VueltoMinor, Converter={StaticResource NullToVisibility}}"/><TextBlock DockPanel.Dock="Right" Text="{Binding VueltoMinor, Converter={StaticResource MinorToArs}}" Visibility="{Binding VueltoMinor, Converter={StaticResource NullToVisibility}}"/></DockPanel></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,8,0,0" Text="{Binding Motivo, StringFormat=Motivo: {0}}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,14,0,0" FontSize="10" Text="Operación no fiscal. Conservá este comprobante como referencia interna." TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
