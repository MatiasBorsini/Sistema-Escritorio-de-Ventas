<UserControl x:Class="LocalInfantil.Wpf.Views.AppRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ContentControl Content="{Binding Contenido}"/>
        <Border Background="#FFF7F7F7" Visibility="{Binding ErrorInicial, Converter={StaticResource NullToVisibility}}" VerticalAlignment="Top" Padding="12" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1">
            <TextBlock Foreground="#B91C1C" Text="{Binding ErrorInicial}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
