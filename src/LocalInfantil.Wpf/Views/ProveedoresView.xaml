<UserControl x:Class="LocalInfantil.Wpf.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Proveedores"/>
            <TextBlock Foreground="#6B7280" Text="Solo nombre comercial. Sin CUIT/domicilio/tel. No se borra con historial." TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Width="200" Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nombre nuevo"/>
                <Button Content="Crear" Margin="8,0,0,0" Padding="8,4" Command="{Binding CrearCommand}"/>
                <CheckBox Margin="12,6,0,0" Content="Solo activos" IsChecked="{Binding SoloActivos}"/>
                <Button Content="Refrescar" Margin="8,0,0,0" Padding="8,4" Command="{Binding RefrescarCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBox Width="200" Text="{Binding EdicionNombre, UpdateSourceTrigger=PropertyChanged}" ToolTip="Editar nombre seleccionado"/>
                <Button Content="Guardar nombre" Margin="8,0,0,0" Padding="8,4" Command="{Binding EditarCommand}"/>
                <Button Content="Desactivar" Margin="8,0,0,0" Padding="8,4" Command="{Binding SolicitarDesactivarCommand}"/>
            </StackPanel>
            <Border Margin="0,8,0,0" Padding="8" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Visibility="{Binding ConfirmacionVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Foreground="#991B1B" TextWrapping="Wrap"><Run Text="¿Confirmás desactivar a "/><Run Text="{Binding NombrePendiente}" FontWeight="SemiBold"/><Run Text="?"/></TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Confirmar" Padding="8,4" Command="{Binding ConfirmarDesactivarCommand}"/>
                        <Button Content="Cancelar" Margin="8,0,0,0" Padding="8,4" Command="{Binding CancelarDesactivarCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Margin="0,6,0,0" Foreground="#DC2626" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Foreground="#059669" Text="{Binding Mensaje}" TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Proveedores}" SelectedItem="{Binding Seleccionado}" DisplayMemberPath="Nombre" MaxHeight="400"/>
    </DockPanel>
</UserControl>
