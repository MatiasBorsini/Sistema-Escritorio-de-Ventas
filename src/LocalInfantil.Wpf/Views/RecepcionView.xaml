<UserControl x:Class="LocalInfantil.Wpf.Views.RecepcionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
        <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="SUMAR INGRESO DE MERCADERÍA — Recepción"/>
            <TextBlock Foreground="#92400E" TextWrapping="Wrap" Text="SUMA existencias (movimientos ingreso). No confundir con ESTABLECER existencia inicial." Margin="0,4,0,8"/>
            <TextBlock Foreground="#DC2626" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Foreground="#059669" Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <ComboBox Width="240" ItemsSource="{Binding Proveedores}" SelectedItem="{Binding ProveedorSeleccionado}" DisplayMemberPath="Nombre" ToolTip="Proveedor"/>
                <Button Content="Refrescar proveedores" Margin="8,0,0,0" Padding="8,4" Command="{Binding RefrescarProveedoresCommand}"/>
            </StackPanel>
            <TextBox Margin="0,0,0,8" Text="{Binding ComprobanteRef, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comprobante referencia (opcional)" Width="300" HorizontalAlignment="Left"/>
            <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding OperacionId, StringFormat=operacion_id: {0}}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Filas}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox Width="140" Margin="0,0,8,0" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" ToolTip="SKU"/>
                            <TextBox Width="90" Margin="0,0,8,0" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad >0"/>
                            <TextBox Width="110" Margin="0,0,8,0" Text="{Binding CostoTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Costo ARS opcional (vacío=NULL, 0=informado cero)"/>
                            <TextBox Width="60" Margin="0,0,8,0" Text="{Binding Moneda, UpdateSourceTrigger=PropertyChanged}" ToolTip="Moneda (ARS)"/>
                            <TextBlock Foreground="#6B7280" FontSize="11" Text="{Binding Detalle}" Width="200" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ Fila" Padding="8,4" Command="{Binding AgregarFilaCommand}"/>
                <Button Content="− Fila" Margin="8,0,0,0" Padding="8,4" Command="{Binding QuitarFilaCommand}"/>
                <Button Content="CONFIRMAR RECEPCIÓN — SUMAR" Margin="12,0,0,0" Padding="12,4" Background="#DBEAFE" BorderBrush="#3B82F6" Command="{Binding ConfirmarCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
