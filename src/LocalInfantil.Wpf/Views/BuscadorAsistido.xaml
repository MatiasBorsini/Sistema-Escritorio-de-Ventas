<UserControl x:Class="LocalInfantil.Wpf.Views.BuscadorAsistido"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="PlantillaVariante">
            <StackPanel Margin="2">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding CodigoInterno}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding NombreProducto}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding DetalleTalleColor, StringFormat= · \{0\}}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="PlantillaProducto">
            <StackPanel Margin="2">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding NombreProducto}"/>
                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding SubProducto}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid x:Name="Raiz">
        <TextBox x:Name="Caja" Style="{StaticResource EstiloCampoTexto}" Margin="0,0,0,0"
                 PreviewKeyDown="Caja_PreviewKeyDown" TextChanged="Caja_TextChanged"
                 LostKeyboardFocus="Caja_LostKeyboardFocus"/>
        <Popup x:Name="PopupSugerencias" PlacementTarget="{Binding ElementName=Caja}" Placement="Bottom"
               IsOpen="{Binding Abierto, Mode=OneWay}" StaysOpen="False" AllowsTransparency="True" Closed="Popup_Closed">
            <Border Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}"
                    BorderThickness="1" CornerRadius="6" MinWidth="280" MaxWidth="420" Padding="4">
                <StackPanel x:Name="PanelContenido">
                    <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Buscando…" Margin="6,4" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Color.ErrorTextBrush}" Text="{Binding Error}" TextWrapping="Wrap" Margin="6,4" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="No encontramos coincidencias." Margin="6,4" Visibility="{Binding SinCoincidencias, Converter={StaticResource BoolToVisibility}}"/>
                    <ListBox x:Name="Lista" ItemsSource="{Binding Sugerencias}" SelectedIndex="{Binding IndiceActivo, Mode=OneWay}"
                             BorderThickness="0" Background="Transparent" MaxHeight="260"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="Lista_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
