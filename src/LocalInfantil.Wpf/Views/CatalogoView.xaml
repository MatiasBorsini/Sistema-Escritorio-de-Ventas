<UserControl x:Class="LocalInfantil.Wpf.Views.CatalogoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0">
            <DockPanel Margin="0,0,0,2">
                <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Catálogo" Margin="0,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource EstiloBotonPrimario}" Content="＋ Nuevo producto" Command="{Binding NuevaFichaCommand}" ToolTip="Abre la ficha en modo creación"/>
                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Editar seleccionado" Command="{Binding AbrirFichaCommand}" ToolTip="Abre la ficha del producto seleccionado (o doble clic)"/>
                    <Button Style="{StaticResource EstiloBotonDangerOutline}" Content="Desactivar" Command="{Binding DesactivarProductoCommand}" ToolTip="Desactiva el producto seleccionado (conserva historial)" Margin="16,0,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Buscá, filtrá y administrá productos. Abrí la ficha completa solo cuando necesites editar o revisar variantes." Margin="0,0,0,2"/>
            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Resumen}" Margin="0,0,0,4"/>
            <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
        </StackPanel>
        <Grid Margin="20,2,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Margin="0,0,12,0" Padding="{StaticResource RellenoPanel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Style="{StaticResource EstiloToolbar}" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="280" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="Busca en nombre, marca y categoría"/>
                            <Button Style="{StaticResource EstiloBotonPrimario}" Content="Buscar" Command="{Binding BuscarCommand}"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource EstiloToolbar}" Orientation="Horizontal">
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="180" Text="{Binding SkuBusqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="SKU exacto de variante"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="Buscar SKU" Command="{Binding BuscarSkuCommand}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Filas:" Margin="8,0,4,0"/>
                            <ComboBox Style="{StaticResource EstiloCombo}" Width="70" ItemsSource="{Binding TamanosPagina}" SelectedItem="{Binding TamanoPagina}" ToolTip="Filas por página (consulta real)"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="◀ Anterior" Command="{Binding AnteriorCommand}" IsEnabled="{Binding HayAnterior}" Margin="8,0,0,0"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="Siguiente ▶" Command="{Binding SiguienteCommand}" IsEnabled="{Binding EsUltimaPagina, Converter={StaticResource BoolInvertido}, FallbackValue=True}"/>
                            <TextBlock Margin="8,6,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding PaginaVisible, StringFormat=Página {0}}"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="Grilla" Style="{StaticResource EstiloGrillaOperativa}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionUnit="FullRow" CanUserSortColumns="False"
                              ItemsSource="{Binding Filas}" SelectedItem="{Binding FilaSeleccionada}"
                              MouseDoubleClick="Grilla_MouseDoubleClick"
                              BorderBrush="{StaticResource Color.BorderBrush}" MinHeight="300">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AbrirFichaCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Producto" Width="2*" MinWidth="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="2" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Producto.Nombre}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Marca" Binding="{Binding Producto.Marca, TargetNullValue=—}" Width="*" MinWidth="100"/>
                            <DataGridTextColumn Header="Categoría" Binding="{Binding Producto.Categoria, TargetNullValue=—}" Width="*" MinWidth="110"/>
                            <DataGridTextColumn Header="Variantes" Binding="{Binding VariantesTexto}" Width="70"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockTexto}" Width="70"/>
                            <DataGridTemplateColumn Header="Estado" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="EstadoTexto" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Inactivo"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Producto.Activo}" Value="True">
                                                <Setter TargetName="EstadoTexto" Property="Text" Value="Activo"/>
                                                <Setter TargetName="EstadoTexto" Property="Foreground" Value="{StaticResource Color.SuccessTextBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Margin="0" Padding="{StaticResource RellenoPanel}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="VISTA RÁPIDA"/>
                        <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Ficha.Producto.Nombre, FallbackValue=Sin selección}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock FontSize="12" Foreground="{StaticResource Color.SuccessTextBrush}" Text="Activo" Visibility="{Binding Ficha.Producto.Activo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Inactivo" Visibility="{Binding Ficha.Producto.Activo, Converter={StaticResource BoolToVisibilityInverted}, FallbackValue=Collapsed}"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Ficha.Producto.Categoria, FallbackValue=—, StringFormat= · {0}}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Style="{StaticResource EstiloSeparador}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Stock total"/>
                                <TextBlock Style="{StaticResource EstiloNumeroMetrica}" Text="{Binding StockVistaTotal, FallbackValue=—, TargetNullValue=—}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Variantes"/>
                                <TextBlock Style="{StaticResource EstiloNumeroMetrica}" Text="{Binding CantidadVariantesVista, FallbackValue=—}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Margin="0,12,0,4" Text="Variantes principales"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="SKU"/>
                            <TextBlock Grid.Column="1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="TALLE / COLOR"/>
                            <TextBlock Grid.Column="2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="STOCK"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding VistaTop3}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Sku}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource Color.TextBrush}" Text="{Binding TalleColorTexto}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Existencias, StringFormat={}{0} u.}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding VariantesRestantes, StringFormat=+ \{0\} variantes más}" Visibility="{Binding HayMasVariantes, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
                        <TextBlock Style="{StaticResource EstiloEstadoVacio}" Text="Seleccioná un producto del listado para ver su contexto." Visibility="{Binding HayFicha, Converter={StaticResource BoolToVisibilityInverted}, FallbackValue=Visible}"/>
                        <Border Style="{StaticResource EstiloSeparador}"/>
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Abrir ficha completa" Command="{Binding AbrirFichaCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,0"/>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Doble clic en el producto abre su ficha: datos, variantes y estado." TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
