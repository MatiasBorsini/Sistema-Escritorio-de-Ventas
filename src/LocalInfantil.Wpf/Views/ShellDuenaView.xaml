<UserControl x:Class="LocalInfantil.Wpf.Views.ShellDuenaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource Color.NavBrush}" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Color.CanvasBrush}" Text="LocalInfantil"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Color.CanvasBrush}" Text="{Binding Sesion.Nombre, Mode=OneWay}"/>
                    <Menu Background="Transparent" VerticalAlignment="Center">
                        <MenuItem Header="_Perfil" Foreground="{StaticResource Color.CanvasBrush}">
                            <MenuItem Header="{Binding Identidad, Mode=OneWay}" IsEnabled="False" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                            <MenuItem Header="Cerrar sesión" Foreground="{StaticResource Color.TextBrush}" Click="Cerrar_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <Menu Margin="16,0,0,0" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="_Inicio" Foreground="{StaticResource Color.CanvasBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Portada}"/>
                    <MenuItem Header="_Catálogo" Foreground="{StaticResource Color.CanvasBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Catalogo}"/>
                    <MenuItem Header="_Ventas" Foreground="{StaticResource Color.CanvasBrush}">
                        <MenuItem Header="Punto de venta" Foreground="{StaticResource Color.TextBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Pos}"/>
                        <MenuItem Header="Consulta de ventas" Foreground="{StaticResource Color.TextBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Ventas}"/>
                    </MenuItem>
                    <MenuItem Header="_Caja" Foreground="{StaticResource Color.CanvasBrush}" Visibility="{Binding Caja.PuedeVer, Converter={StaticResource BoolToVisibility}}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Caja}"/>
                    <MenuItem Header="Co_mpras" Foreground="{StaticResource Color.CanvasBrush}">
                        <MenuItem Header="PROVEEDORES" Style="{StaticResource EstiloItemSeccionMenu}"/>
                        <MenuItem Header="Proveedores" Foreground="{StaticResource Color.TextBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Proveedores}"/>
                        <Separator/>
                        <MenuItem Header="MERCADERÍA" Style="{StaticResource EstiloItemSeccionMenu}"/>
                        <MenuItem Header="Recepción de mercadería" Foreground="{StaticResource Color.TextBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Recepcion}"/>
                        <MenuItem Header="Consultas y reversiones" Foreground="{StaticResource Color.TextBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Recepciones}"/>
                    </MenuItem>
                    <MenuItem Header="I_nventario" Foreground="{StaticResource Color.CanvasBrush}">
                        <MenuItem Header="STOCK" Style="{StaticResource EstiloItemSeccionMenu}"/>
                        <MenuItem Header="Consulta de inventario" Foreground="{StaticResource Color.TextBrush}" Command="{Binding IrAApartadoCommand}"/>
                        <MenuItem Header="Conteo físico" Foreground="{StaticResource Color.TextBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Conteo}"/>
                        <Separator/>
                        <MenuItem Header="CLASIFICACIÓN" Style="{StaticResource EstiloItemSeccionMenu}"/>
                        <MenuItem Header="No vendible" Foreground="{StaticResource Color.TextBrush}" Command="{Binding IrAApartadoCommand}" CommandParameter="Apartar"/>
                    </MenuItem>
                    <MenuItem Header="_Administración" Foreground="{StaticResource Color.CanvasBrush}">
                        <MenuItem Header="ACCESOS" Style="{StaticResource EstiloItemSeccionMenu}"/>
                        <MenuItem Header="Usuarios" Foreground="{StaticResource Color.TextBrush}" Command="{Binding MostrarVistaCommand}" CommandParameter="{Binding Administracion}"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding VistaActual}"/>
    </DockPanel>
</UserControl>
