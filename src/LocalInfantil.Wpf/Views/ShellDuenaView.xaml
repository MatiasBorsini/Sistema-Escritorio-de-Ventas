<UserControl x:Class="LocalInfantil.Wpf.Views.ShellDuenaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Identidad}"/>
                <Button DockPanel.Dock="Right" Content="Cerrar sesión" Padding="8,3" Click="Cerrar_Click"/>
            </DockPanel>
        </Border>
        <TabControl>
            <TabItem Header="Catálogo">
                <views:CatalogoView DataContext="{Binding Catalogo}"/>
            </TabItem>
            <TabItem Header="Administración">
                <views:AdministracionUsuariosView DataContext="{Binding Administracion}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
