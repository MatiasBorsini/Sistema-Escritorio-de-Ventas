<UserControl x:Class="LocalInfantil.Wpf.Views.ActualizacionesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="640">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Actualizaciones" />
        <TextBlock Margin="0,4,0,0" Foreground="#4B5563" TextWrapping="Wrap"
                   Text="Al buscar, una versión superior válida se descarga en segundo plano. La instalación siempre requiere confirmación." />

        <Border Margin="0,14,0,0" Padding="12" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontWeight="SemiBold" Text="Versión instalada" />
                <TextBlock Grid.Column="1" Text="{Binding VersionInstalada}" />
                <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Versión disponible" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VersionDisponible, TargetNullValue=—}" />
                <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Última comprobación" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding UltimaComprobacionUtc, TargetNullValue=—}" />
                <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Estado" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EstadoTexto}" />
            </Grid>
        </Border>

        <TextBlock Margin="0,10,0,0" Foreground="#4B5563" TextWrapping="Wrap"
                   Text="{Binding NotasVersion}" />

        <TextBlock Margin="0,6,0,0" Foreground="#B45309" TextWrapping="Wrap"
                   Text="{Binding ProgresoTexto}" />

        <TextBlock Margin="0,6,0,0" Foreground="#047857" TextWrapping="Wrap"
                   Text="{Binding Mensaje}" />
        <TextBlock Margin="0,6,0,0" Foreground="#B91C1C" TextWrapping="Wrap"
                   Text="{Binding Error}" />

        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
            <Button Width="160" Content="Buscar actualizaciones" Command="{Binding ComprobarCommand}"
                    IsEnabled="{Binding PuedeComprobar}" />
            <Button Width="160" Margin="8,0,0,0" Content="Cancelar" Command="{Binding CancelarDescargaCommand}"
                    IsEnabled="{Binding Descargando}" />
        </StackPanel>
        <Button Width="200" Margin="0,8,0,0" HorizontalAlignment="Left" Content="Instalar actualización"
                Command="{Binding InstalarCommand}" IsEnabled="{Binding PuedeInstalar}"
                Visibility="{Binding PuedeInstalar, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Margin="0,8,0,0" Foreground="#4B5563" TextWrapping="Wrap"
                   Text="La descarga se valida antes de quedar lista. Instalar requiere confirmación y caja cerrada." />
    </StackPanel>
</UserControl>
