<Window x:Class="LocalInfantil.Wpf.Views.ConfirmarCambioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework"
        Title="Confirmar operación" Width="720" MinWidth="620" MaxWidth="900"
        MaxHeight="{Binding Height, Source={x:Static sw:SystemParameters.WorkArea}}"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Color.CanvasBrush}" AutomationProperties.Name="Confirmar operación">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource Color.TextBrush}" Text="Confirmar cambio o devolución"/>
            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}"
                       Text="Revisá el resultado y completá los datos necesarios antes de registrar." TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource EstiloTarjeta}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="RESUMEN DE LA OPERACIÓN"/>
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Color.TextBrush}" Text="{Binding VentaContexto}" TextWrapping="Wrap"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Crédito por prendas que vuelven"/>
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right" Text="{Binding CreditoEntradasTexto}"/>
                        <TextBlock Grid.Row="1" Margin="0,3,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Artículos nuevos"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,3,0,0" HorizontalAlignment="Right" Text="{Binding TotalSalidasTexto}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="RESULTADO"/>
                    <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}"
                               Text="{Binding ResultadoDiferenciaTexto}" TextWrapping="Wrap" MaxWidth="230"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource EstiloTarjeta}" Padding="12" Margin="0,0,0,10"
                        Visibility="{Binding DiferenciaPositiva, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding PuedeEditarOperacion}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Medios para cobrar la diferencia" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonSecundario}" Content="+ Agregar medio"
                                    Command="{Binding AgregarPagoCommand}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Pagos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Fila compacta con separador fino en lugar de tarjeta anidada -->
                                    <Border Padding="0,6,0,7" BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Medio de pago" Margin="0,0,10,4"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource EstiloEtiqueta}" Text="Importe" Margin="0,0,0,4"/>
                                            <Button Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource EstiloBotonQuiet}" Content="Quitar" Margin="10,0,0,0"
                                                    Command="{Binding DataContext.QuitarPagoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.PuedeQuitarPago, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <ComboBox Grid.Row="1" Style="{StaticResource EstiloCombo}"
                                                      ItemsSource="{Binding DataContext.Medios, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Texto" SelectedValuePath="Valor" SelectedValue="{Binding Medio}" Margin="0,0,10,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource EstiloCampoTexto}"
                                                     Text="{Binding ImporteTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Importe que se cobra con este medio"/>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,7,0,0"
                                                        Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Efectivo recibido" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Width="170" Style="{StaticResource EstiloCampoTexto}"
                                                         Text="{Binding RecibidoTexto, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Dinero físico entregado por el cliente"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,3,0,0" Foreground="{StaticResource Color.ErrorTextBrush}" Text="{Binding ErrorCobro}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EstiloTarjeta}" Padding="12" Margin="0,0,0,10"
                        Visibility="{Binding DiferenciaNegativa, Converter={StaticResource BoolToVisibility}}"
                        IsEnabled="{Binding PuedeEditarOperacion}">
                    <StackPanel>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Datos del reintegro"/>
                        <TextBlock Margin="0,2,0,8" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                   Text="El importe a reintegrar surge de la diferencia. No se modifican los precios históricos." TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Medio de reintegro"/>
                        <ComboBox Margin="0,4,0,8" Style="{StaticResource EstiloCombo}" ItemsSource="{Binding MediosReintegro}"
                                  SelectedItem="{Binding MedioReintegro}"/>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Motivo del reintegro"/>
                        <TextBox Margin="0,4,0,2" Style="{StaticResource EstiloCampoTexto}" MinHeight="60" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Foreground="{StaticResource Color.ErrorTextBrush}" Text="{Binding ErrorMotivo}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Color.WarningTextBrush}"
                                   Text="El cambio registra el crédito local. El reembolso de Mercado Pago es una operación remota separada." TextWrapping="Wrap"
                                   Visibility="{Binding AvisoReintegroMpVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Margin="0,5,0,0" Foreground="{StaticResource Color.WarningTextBrush}"
                                   Text="Mercado Pago requiere además completar el reembolso remoto; esta operación local no lo ejecuta."
                                   TextWrapping="Wrap" Visibility="{Binding AvisoReembolsoMpSeparadoVisible, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding RequiereAutorizacionPresencial, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Autorización presencial de Dueña"/>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Usuario autorizante"/>
                            <TextBox Margin="0,4,0,6" Style="{StaticResource EstiloCampoTexto}"
                                     Text="{Binding UsuarioAutorizante, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Contraseña de Dueña"/>
                            <PasswordBox x:Name="ContrasenaDuena" Margin="0,4,0,0" MinHeight="34"
                                         PasswordChanged="ContrasenaDuena_PasswordChanged"/>
                        </StackPanel>
                        <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                   Text="El reintegro se registra en la caja abierta. Un reintegro por Mercado Pago también debe gestionarse en la cuenta de Mercado Pago." TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource EstiloTarjeta}" Padding="12" Margin="0,0,0,10"
                        Visibility="{Binding DiferenciaCero, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="No hay cobro ni reintegro. Al confirmar se registrará únicamente el cambio de prendas." TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Style="{StaticResource EstiloBotonSecundario}" Content="Volver a la preparación" IsCancel="True"/>
            <Button x:Name="ConfirmarButton" Grid.Column="1" Style="{StaticResource EstiloBotonPrimario}"
                    Content="Confirmar operación" IsDefault="True" IsEnabled="{Binding PuedeRegistrarOperacion}"
                    Click="Confirmar_Click" MinWidth="170" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
