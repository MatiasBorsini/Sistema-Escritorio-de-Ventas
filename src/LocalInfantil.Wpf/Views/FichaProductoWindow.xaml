<Window x:Class="LocalInfantil.Wpf.Views.FichaProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding TituloVentana, Mode=OneWay}"
        Width="1100" Height="700" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Color.SurfaceBrush}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding TituloVentana, Mode=OneWay}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding SubtituloVentana, Mode=OneWay}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonQuiet}" Content="✕" Width="32" Click="Cerrar_Click" ToolTip="Cerrar (Esc)" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Doble clic en el master abre esta ficha. Los cambios se guardan por sección."/>
                <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonPrimario}" Content="Cerrar" Click="Cerrar_Click" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="0,0,1,0" Padding="16">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Ficha.Producto.Nombre, FallbackValue=Nuevo producto}" TextWrapping="Wrap"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Producto activo" Visibility="{Binding Ficha.Producto.Activo, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Producto inactivo" Visibility="{Binding Ficha.Producto.Activo, Converter={StaticResource BoolToVisibilityInverted}, FallbackValue=Collapsed}"/>
                    <Border Style="{StaticResource EstiloSeparador}"/>
                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Datos generales" Command="{Binding SeleccionarSolapaCommand}" CommandParameter="Datos" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Variantes" Command="{Binding SeleccionarSolapaCommand}" CommandParameter="Variantes" IsEnabled="{Binding SolapasSecundariasHabilitadas}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Estado y acciones" Command="{Binding SeleccionarSolapaCommand}" CommandParameter="Estado" IsEnabled="{Binding SolapasSecundariasHabilitadas}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Edición independiente" TextWrapping="Wrap"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="La lista principal queda enfocada en buscar productos." TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>
                    <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
                    <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>

                    <StackPanel Visibility="{Binding SolapaDatosVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Datos generales" FontSize="16"/>
                        <TextBlock Style="{StaticResource EstiloAyuda}" Text="Editá la información comercial del producto."/>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Nombre"/>
                        <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Marca (opcional)"/>
                                <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Categoría (opcional)"/>
                                <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Categoria, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource EstiloBotonPrimario}" Content="Crear producto" Command="{Binding GuardarDatosCommand}" Visibility="{Binding EsCreacion, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource EstiloBotonPrimario}" Content="Guardar cambios" Command="{Binding GuardarDatosCommand}" Visibility="{Binding EsCreacion, Converter={StaticResource BoolToVisibilityInverted}}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SolapaVariantesVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Variantes" FontSize="16"/>
                        <TextBlock Style="{StaticResource EstiloAyuda}" Text="Administrá talle, color, SKU, precio y existencia inicial. El SKU es único e inmutable."/>
                        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  ItemsSource="{Binding Ficha.Variantes}" SelectedItem="{Binding VarianteSeleccionada}"
                                  MinHeight="140" MaxHeight="260" BorderBrush="{StaticResource Color.BorderBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140"/>
                                <DataGridTextColumn Header="Talle" Binding="{Binding Talle, TargetNullValue=—}" Width="80"/>
                                <DataGridTextColumn Header="Color" Binding="{Binding Color, TargetNullValue=—}" Width="100"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding Existencias}" Width="70"/>
                                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioMinor, Converter={StaticResource MinorToArs}}" Width="130"/>
                                <DataGridTemplateColumn Header="Estado" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock x:Name="EstadoTexto" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Inactiva"/>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Activa}" Value="True">
                                                    <Setter TargetName="EstadoTexto" Property="Text" Value="Activa"/>
                                                    <Setter TargetName="EstadoTexto" Property="Foreground" Value="{StaticResource Color.SuccessTextBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Margin="0,12,0,4" Text="Nueva variante"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="170" Text="{Binding NuevoVarianteSku, UpdateSourceTrigger=PropertyChanged}" ToolTip="SKU único e inmutable"/>
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="110" Text="{Binding NuevoVarianteTalle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Talle (vacío = sin talle)"/>
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="130" Text="{Binding NuevoVarianteColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Color (vacío = sin color)"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="Agregar variante" Command="{Binding CrearVarianteCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Margin="0,12,0,4" Text="Editar seleccionada (talle/color)"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="110" Text="{Binding NuevoVarianteTalle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Talle"/>
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="130" Text="{Binding NuevoVarianteColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="Color"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="Guardar talle/color" Command="{Binding EditarVarianteCommand}"/>
                            <Button Style="{StaticResource EstiloBotonDangerOutline}" Content="Desactivar variante" Command="{Binding DesactivarVarianteCommand}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Margin="0,12,0,4" Text="Precio de la variante seleccionada"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="150" Text="{Binding PrecioTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nuevo precio, ej: 1234,50. Se crea un precio nuevo; el anterior queda en el historial."/>
                            <Button Style="{StaticResource EstiloBotonPrimario}" Content="Fijar nuevo precio" Command="{Binding FijarPrecioCommand}"/>
                        </StackPanel>
                        <Border Style="{StaticResource EstiloSeparador}"/>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Establecer existencia inicial"/>
                        <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Text="ESTABLECE la cantidad inicial. No suma una recepción."/>
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding FilasCarga}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBox Style="{StaticResource EstiloCampoTexto}" Width="170" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" ToolTip="SKU"/>
                                        <TextBox Style="{StaticResource EstiloCampoTexto}" Width="110" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Cantidad entera mayor a cero"/>
                                        <TextBlock Margin="8,4,0,0" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Detalle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="+ Fila" Command="{Binding AgregarFilaCargaCommand}"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="− Fila" Command="{Binding QuitarFilaCargaCommand}"/>
                            <Button Style="{StaticResource EstiloBotonPrimario}" Content="Establecer existencia inicial" Command="{Binding EjecutarCargaCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding SolapaEstadoVisible, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Estado y acciones" FontSize="16"/>
                        <TextBlock Style="{StaticResource EstiloAyuda}" Text="Acciones poco frecuentes, separadas de la edición cotidiana."/>
                        <Border Style="{StaticResource EstiloAvisoInfo}">
                            <TextBlock Foreground="{StaticResource Color.InfoTextBrush}" FontSize="13" TextWrapping="Wrap" Text="Las variantes activas siguen disponibles para operaciones del sistema. Desactivar no elimina el historial."/>
                        </Border>
                        <Border Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.DestructiveBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.DestructiveBrush}" Text="Desactivar producto"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="No elimina el historial. Evita nuevas operaciones según las reglas del sistema." TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonDangerOutline}" Content="Desactivar producto" Command="{Binding DesactivarProductoCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
