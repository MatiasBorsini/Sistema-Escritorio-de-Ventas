<UserControl x:Class="LocalInfantil.Wpf.Views.RespaldosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Respaldos" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"/>
            <TextBlock Text="Copia local cifrada; Google Drive se puede configurar cuando esté disponible." Margin="0,4,0,16" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
            <Border Padding="16" Margin="0,0,0,12" Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="ESTADO" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Estado}" Margin="0,8,0,2" FontSize="16"/>
                    <TextBlock Text="{Binding RutaLocal}" TextWrapping="Wrap" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                    <TextBlock Text="Aviso: esta ubicación parece estar dentro de una carpeta sincronizada. Los respaldos no deben sincronizarse directamente; elegí una ruta local dedicada." Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{StaticResource Color.ErrorTextBrush}" Visibility="{Binding RutaPuedeSincronizarse, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="Google Drive todavía no está configurado. Definí el Desktop Client ID de OAuth para esta instalación." Margin="0,8,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" Visibility="{Binding DriveConfigurado, Converter={StaticResource BoolToVisibilityInverted}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Google Drive:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="Conectado" Margin="8,0,12,0" VerticalAlignment="Center" Visibility="{Binding DriveConectado, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="Requiere conectar" Margin="8,0,12,0" VerticalAlignment="Center" Visibility="{Binding DriveConectado, Converter={StaticResource BoolToVisibilityInverted}}"/>
                        <Button Content="Conectar Google Drive" Command="{Binding ConectarDriveCommand}" IsEnabled="{Binding PuedeConfigurar}" Visibility="{Binding DriveConfigurado, Converter={StaticResource BoolToVisibility}}" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="16" Margin="0,0,0,12" Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding PuedeConfigurar, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="CONFIGURACIÓN INICIAL" FontWeight="SemiBold"/>
                    <TextBlock Text="Generá el código de recuperación y guardalo fuera de esta computadora. Sin él no se podrá abrir una copia en una PC nueva." Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <Button Content="Generar código de recuperación" Command="{Binding GenerarCodigoCommand}" HorizontalAlignment="Left" Padding="12,6"/>
                    <TextBox Text="{Binding Codigo}" IsReadOnly="True" Margin="0,10,0,8" FontSize="18" FontWeight="SemiBold"/>
                    <Button Content="Imprimir hoja de recuperación…" Click="ImprimirHoja_Click" IsEnabled="{Binding HayCodigo}" HorizontalAlignment="Left" Padding="12,6"/>
                    <TextBlock Text="{Binding Mensaje}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="Volvé a escribir el código para confirmar:" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding Confirmacion, UpdateSourceTrigger=PropertyChanged}" MaxWidth="500" HorizontalAlignment="Left"/>
                    <Button Content="Confirmar y proteger en este Windows" Command="{Binding ConfirmarCodigoCommand}" Margin="0,8,0,0" HorizontalAlignment="Left" Padding="12,6"/>
                    <TextBlock Text="En una PC nueva, pegá aquí el código original y elegí protegerlo para esta cuenta de Windows." Margin="0,12,0,4" TextWrapping="Wrap" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                    <Button Content="Proteger código existente / recuperar esta PC" Command="{Binding ProtegerCodigoExistenteCommand}" HorizontalAlignment="Left" Padding="12,6"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Crear copia ahora" Command="{Binding CrearCopiaCommand}" IsEnabled="{Binding PuedeCrear}" Visibility="{Binding PuedeCrear, Converter={StaticResource BoolToVisibility}}" Padding="14,7"/>
                <Button Content="Actualizar" Command="{Binding ActualizarCommand}" Margin="8,0,0,0" Padding="14,7"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Color.ErrorTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource Color.SuccessTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <DataGrid ItemsSource="{Binding Copias}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MinHeight="180">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha UTC" Binding="{Binding CreadoUtc}" Width="190"/>
                    <DataGridTextColumn Header="Motivo" Binding="{Binding MotivoHumano}" Width="130"/>
                    <DataGridTextColumn Header="Estado local" Binding="{Binding EstadoLocal}" Width="140"/>
                    <DataGridTextColumn Header="Drive" Binding="{Binding EstadoRemotoHumano}" Width="150"/>
                    <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoBytes}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Padding="16" Margin="0,12,0,0" Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding PuedeRestaurar, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="RESTAURAR UN RESPALDO" FontWeight="SemiBold"/>
                    <TextBlock Text="Solo Dueña. Se requiere reautenticación, caja cerrada y código de recuperación. Se verificará una copia actual antes del reemplazo." Margin="0,5,0,10" TextWrapping="Wrap" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                    <TextBlock Text="Copias en Google Drive (útil al recuperar una PC nueva)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Consultar copias remotas" Command="{Binding ActualizarDriveCommand}" Padding="10,5"/>
                        <Button Content="Descargar seleccionada" Command="{Binding DescargarDriveCommand}" Margin="8,0,0,0" Padding="10,5"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding CopiasDrive}" SelectedItem="{Binding CopiaDriveSeleccionada}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="180" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha UTC" Binding="{Binding CreadoUtc}" Width="190"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="130"/>
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding TamanoBytes}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Seleccionar archivo .libackup" Command="{Binding SeleccionarArchivoCommand}" Padding="10,5"/>
                        <TextBlock Text="{Binding ArchivoRestauracion}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                    </StackPanel>
                    <TextBlock Text="Código de recuperación" Margin="0,10,0,3"/>
                    <TextBox Text="{Binding CodigoRestauracion, UpdateSourceTrigger=PropertyChanged}" MaxWidth="500" HorizontalAlignment="Left"/>
                    <TextBlock Text="Contraseña de Dueña para reautenticar" Margin="0,8,0,3"/>
                    <PasswordBox x:Name="PasswordDuena" MaxWidth="500" HorizontalAlignment="Left"/>
                    <Button Content="Verificar y restaurar" Click="Restaurar_Click" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,6"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
