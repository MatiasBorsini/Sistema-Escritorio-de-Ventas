<UserControl x:Class="LocalInfantil.Wpf.Views.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource Color.CanvasBrush}">
        <Grid Margin="20" Visibility="{Binding FueraDeArqueo, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Caja" Style="{StaticResource EstiloTituloPagina}"/>
                    <TextBlock Text="Sesión única · importes en pesos argentinos" Style="{StaticResource EstiloAyuda}" Margin="0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Top">
                    <TextBlock Text="{Binding EstadoTexto}" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"/>
                </Border>
            </DockPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="Sesión actual">
                    <Grid Margin="12">
                        <Border Style="{StaticResource EstiloTarjeta}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Top" Width="460"
                                Visibility="{Binding CajaCerrada, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Caja cerrada" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"/>
                                <TextBlock Text="Abrí una sesión para registrar ventas y movimientos." Style="{StaticResource EstiloAyuda}" Margin="0,4,0,12"/>
                                <TextBlock Text="Fondo inicial" Style="{StaticResource EstiloEtiqueta}"/>
                                <TextBox Text="{Binding FondoInicialTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EstiloCampoTexto}" Margin="0,0,0,12"/>
                                <Button Content="Abrir caja" Command="{Binding AbrirCommand}" IsEnabled="{Binding PuedeAbrir}" Style="{StaticResource EstiloBotonPrimario}" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Color.ErrorTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource Color.SuccessTextBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Visibility="{Binding CajaAbierta, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource EstiloTarjeta}" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.25*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SesionTexto}" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"/>
                                        <TextBlock Text="Fondo inicial" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding FondoInicialActualTexto}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="Cobros en efectivo" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CobrosEfectivoTexto}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                        <TextBlock Text="Ingresos / egresos" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                        <TextBlock><Run Text="{Binding IngresosTexto, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding EgresosTexto, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="Efectivo esperado" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding EfectivoEsperadoTexto}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"><TextBlock Text="Transferencia" Foreground="{StaticResource Color.TextSecondaryBrush}"/><TextBlock Text="{Binding TransferenciaTexto}"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Débito" Foreground="{StaticResource Color.TextSecondaryBrush}"/><TextBlock Text="{Binding DebitoTexto}"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Crédito" Foreground="{StaticResource Color.TextSecondaryBrush}"/><TextBlock Text="{Binding CreditoTexto}"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="Billetera virtual" Foreground="{StaticResource Color.TextSecondaryBrush}"/><TextBlock Text="{Binding BilleteraTexto}"/></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="Mercado Pago" Foreground="{StaticResource Color.TextSecondaryBrush}"/><TextBlock Text="{Binding MercadoPagoTexto}"/></StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Reintegros en efectivo: " Foreground="{StaticResource Color.TextSecondaryBrush}"/><TextBlock Text="{Binding ReintegrosEfectivoTexto}" FontWeight="SemiBold" Margin="0,0,18,0"/>
                                        <TextBlock Text="Compensaciones en efectivo: " Foreground="{StaticResource Color.TextSecondaryBrush}"/><TextBlock Text="{Binding CompensacionesEfectivoTexto}" FontWeight="SemiBold"/>
                                        <TextBlock Text=" · Electrónicos netos para conciliación; no integran el efectivo contado." Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TabControl Grid.Row="1" Margin="0,0,0,10">
                                <TabItem Header="Movimientos">
                                    <Grid>
                                        <DataGrid ItemsSource="{Binding Movimientos}" Style="{StaticResource EstiloGrillaOperativa}"
                                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False"
                                                  CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="118"/>
                                                <DataGridTextColumn Header="Movimiento" Binding="{Binding Descripcion}" Width="2*"/>
                                                <DataGridTextColumn Header="Medio" Binding="{Binding Medio}" Width="130"/>
                                                <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" Width="145"/>
                                                <DataGridTextColumn Header="Responsable" Binding="{Binding Usuario}" Width="135"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Todavía no hay movimientos registrados en esta sesión." Visibility="{Binding SinMovimientos, Converter={StaticResource BoolToVisibility}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Registrar movimiento" IsEnabled="{Binding PuedeMover}">
                                    <Grid Margin="14" MaxWidth="620" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Tipo" Style="{StaticResource EstiloEtiqueta}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding TiposMovimiento}" SelectedItem="{Binding TipoMovimientoSeleccionado}" Style="{StaticResource EstiloCombo}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="1" Text="Categoría" Style="{StaticResource EstiloEtiqueta}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CategoriasDisponibles}" DisplayMemberPath="Texto" SelectedItem="{Binding CategoriaSeleccionada}" Style="{StaticResource EstiloCombo}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="2" Text="Importe" Style="{StaticResource EstiloEtiqueta}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ImporteMovimientoTexto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EstiloCampoTexto}" Margin="0,0,0,8"/>
                                        <TextBlock Grid.Row="3" Text="Motivo" Style="{StaticResource EstiloEtiqueta}" VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MotivoMovimiento, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EstiloCampoTexto}" Margin="0,0,0,8"/>
                                        <Button Grid.Row="4" Grid.Column="1" Content="Registrar movimiento" Command="{Binding RegistrarMovimientoCommand}" Style="{StaticResource EstiloBotonPrimario}" HorizontalAlignment="Left"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Corregir forma de cobro" IsEnabled="{Binding PuedeCorregir}">
                                    <Grid Margin="14">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="Buscar venta" Style="{StaticResource EstiloEtiqueta}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="BusquedaVentaCajaTextBox" Grid.Column="1" Text="{Binding BusquedaPago, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EstiloCampoTexto}"
                                                     ToolTip="Ticket, producto o código" AutomationProperties.Name="Buscar venta por ticket, producto o código"
                                                     GotKeyboardFocus="BusquedaVentaCaja_GotKeyboardFocus" PreviewKeyDown="BusquedaVentaCaja_PreviewKeyDown"/>
                                            <Button Grid.Column="2" Content="×" Command="{Binding LimpiarBusquedaVentasCommand}" Style="{StaticResource EstiloBotonSecundario}"
                                                    Margin="6,0,0,0" Padding="10,2" ToolTip="Borrar búsqueda" AutomationProperties.Name="Borrar búsqueda"/>
                                        </Grid>
                                        <Border Grid.Row="1" Margin="0,0,0,8" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1"
                                                Background="{StaticResource Color.SurfaceBrush}" CornerRadius="5" MaxHeight="225"
                                                Visibility="{Binding SugerenciasVentasAbiertas, Converter={StaticResource BoolToVisibility}}">
                                            <Grid>
                                                <ListBox x:Name="SugerenciasVentasCajaListBox" ItemsSource="{Binding VentasSugeridas}"
                                                         PreviewMouseLeftButtonUp="SugerenciasVentasCaja_PreviewMouseLeftButtonUp"
                                                         PreviewKeyDown="SugerenciasVentasCaja_PreviewKeyDown"
                                                         Visibility="{Binding HaySugerenciasVentas, Converter={StaticResource BoolToVisibility}}"
                                                         MaxHeight="225" BorderThickness="0" Background="Transparent"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Ventas encontradas">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="9,6"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Numero, StringFormat=Venta {0}}" FontWeight="SemiBold"/>
                                                                    <TextBlock Text="{Binding Fecha}" Style="{StaticResource EstiloAyuda}" Margin="0,1,0,0"/>
                                                                    <TextBlock Text="{Binding Medios}" Style="{StaticResource EstiloAyuda}" Margin="0,1,0,0"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                    <TextBlock Text="{Binding Total}" FontWeight="SemiBold" TextAlignment="Right"/>
                                                                    <TextBlock Text="{Binding Estado}" Style="{StaticResource EstiloAyuda}" TextAlignment="Right"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="{Binding EstadoBusquedaVentas}" Style="{StaticResource EstiloAyuda}"
                                                           TextAlignment="Center" VerticalAlignment="Center" Margin="12"
                                                           Visibility="{Binding HaySugerenciasVentas, Converter={StaticResource BoolToVisibilityInverted}}"/>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="{Binding EstadoBusquedaVentas}"
                                                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="20"
                                                       Foreground="{StaticResource Color.TextSecondaryBrush}"
                                                       Visibility="{Binding SinPagoSeleccionado, Converter={StaticResource BoolToVisibility}}"/>
                                            <Grid Grid.Column="0">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <TextBlock Text="{Binding VentaCorreccionSeleccionadaTexto}" Style="{StaticResource EstiloEtiqueta}"
                                                           TextWrapping="Wrap" Margin="2,0,0,6"
                                                           Visibility="{Binding TieneVentaCorreccionSeleccionada, Converter={StaticResource BoolToVisibility}}"/>
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding PagosCorregibles}" SelectedItem="{Binding PagoSeleccionado}"
                                                      Style="{StaticResource EstiloGrillaOperativa}" IsReadOnly="True" AutoGenerateColumns="False"
                                                      CanUserAddRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                                                      Visibility="{Binding SinPagosCorregibles, Converter={StaticResource BoolToVisibilityInverted}}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Venta" Binding="{Binding NumeroVenta}" Width="95"/>
                                                    <DataGridTextColumn Header="Forma original" Binding="{Binding MedioOriginal, Converter={StaticResource CajaTextoHumano}}" Width="*"/>
                                                    <DataGridTextColumn Header="Importe" Binding="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}" Width="115"/>
                                                </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                            <Border Grid.Column="1" Margin="12,0,0,0" Padding="14" BorderThickness="1" BorderBrush="{StaticResource Color.BorderBrush}"
                                                    Background="{StaticResource Color.SurfaceBrush}" CornerRadius="6"
                                                    Visibility="{Binding TienePagoSeleccionado, Converter={StaticResource BoolToVisibility}}">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel>
                                                        <TextBlock Text="Pago seleccionado" FontSize="16" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding PagoSeleccionado.NumeroVenta, StringFormat=Venta {0}}" Style="{StaticResource EstiloAyuda}" Margin="0,2,0,8"/>
                                                        <TextBlock Text="Medio original" Style="{StaticResource EstiloEtiqueta}"/>
                                                        <TextBlock Text="{Binding PagoSeleccionado.MedioOriginal, Converter={StaticResource CajaTextoHumano}}" Margin="0,0,0,7"/>
                                                        <TextBlock Text="Importe (no cambia)" Style="{StaticResource EstiloEtiqueta}"/>
                                                        <TextBlock Text="{Binding PagoSeleccionado.ImporteMinor, Converter={StaticResource MinorToArs}}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                        <TextBlock Text="Forma de cobro correcta" Style="{StaticResource EstiloEtiqueta}"/>
                                                        <ComboBox ItemsSource="{Binding MediosDisponibles}" DisplayMemberPath="Texto" SelectedValuePath="Valor"
                                                                  SelectedValue="{Binding MedioNuevo}" Style="{StaticResource EstiloCombo}"/>
                                                        <TextBlock Text="Motivo (obligatorio)" Style="{StaticResource EstiloEtiqueta}" Margin="0,7,0,2"/>
                                                        <TextBox Text="{Binding MotivoCorreccion, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EstiloCampoTexto}"
                                                                 ToolTip="Explicá por qué se corrige la forma de cobro"/>
                                                        <TextBlock Text="{Binding SesionOrigenTexto}" Style="{StaticResource EstiloAyuda}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                        <TextBlock Text="{Binding SesionDestinoTexto}" Style="{StaticResource EstiloAyuda}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding ImpactoEfectivoTexto}" Style="{StaticResource EstiloAyuda}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                        <TextBlock Text="{Binding ErrorValidacionCorreccion}" Foreground="{StaticResource Color.ErrorTextBrush}"
                                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                        <Button Content="Confirmar corrección" Click="Corregir_Click" IsEnabled="{Binding PuedeConfirmarCorreccion}"
                                                                Style="{StaticResource EstiloBotonPrimario}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                            <DockPanel Grid.Row="2">
                                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Color.ErrorTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Mensaje}" Foreground="{StaticResource Color.SuccessTextBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                <Button DockPanel.Dock="Right" Content="Cerrar caja" Command="{Binding IniciarArqueoCommand}" IsEnabled="{Binding PuedeCerrar}" Style="{StaticResource EstiloBotonPrimario}" Margin="0"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Historial" IsEnabled="{Binding PuedeConsultar}">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DataGrid Grid.Row="0" ItemsSource="{Binding Historial}" SelectedItem="{Binding SesionSeleccionada}" Style="{StaticResource EstiloGrillaOperativa}"
                                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserReorderColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Apertura" Binding="{Binding AbiertaEn, Converter={StaticResource FechaCorta}}" Width="*"/>
                                <DataGridTextColumn Header="Fondo" Binding="{Binding FondoInicialMinor, Converter={StaticResource MinorToArs}}" Width="130"/>
                                <DataGridTextColumn Header="Diferencia" Binding="{Binding DiferenciaMinor, Converter={StaticResource MinorToArs}}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Todavía no hay cierres registrados." Visibility="{Binding SinHistorial, Converter={StaticResource BoolToVisibility}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}" IsHitTestVisible="False"/>
                        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Detalle de sesión" Style="{StaticResource EstiloTituloPagina}" FontSize="19"/>
                                <TextBlock Text="{Binding DetalleHistorico.Sesion.Estado, Converter={StaticResource CajaTextoHumano}}" Style="{StaticResource EstiloAyuda}"/>
                                <TextBlock Text="{Binding DetalleHistorico.Sesion.UsuarioAperturaNombre, StringFormat=Apertura: {0}}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding DetalleHistorico.Sesion.UsuarioCierreNombre, StringFormat=Cierre: {0}}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding DetalleHistorico.Sesion.FondoInicialMinor, Converter={StaticResource MinorToArs}, StringFormat=Fondo: {0}}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding DetalleHistorico.EfectivoEsperadoMinor, Converter={StaticResource MinorToArs}, StringFormat=Esperado: {0}}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding DetalleHistorico.Sesion.EfectivoContadoMinor, Converter={StaticResource MinorToArs}, StringFormat=Contado: {0}}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding DetalleHistorico.Sesion.DiferenciaMinor, Converter={StaticResource MinorToArs}, StringFormat=Diferencia: {0}}" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding DetalleHistorico.Sesion.ObservacionCierre, StringFormat=Observación: {0}}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Resumen por medio" Style="{StaticResource EstiloEtiqueta}"/>
                                <ItemsControl ItemsSource="{Binding DetalleHistorico.ResumenMedios}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/>
                                                <TextBlock Text="{Binding Medio, Converter={StaticResource CajaTextoHumano}}"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Movimientos" Style="{StaticResource EstiloEtiqueta}"/>
                                <ItemsControl ItemsSource="{Binding MovimientosHistoricos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Importe}"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Descripcion}"/>
                                                    <TextBlock Text="{Binding Fecha}" FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="1" Grid.Column="0" Content="Cargar más sesiones" Command="{Binding CargarMasHistorialCommand}" IsEnabled="{Binding HayMasHistorial}" Style="{StaticResource EstiloBotonSecundario}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <ContentControl Content="{Binding Arqueo}" Visibility="{Binding EnArqueo, Converter={StaticResource BoolToVisibility}}"/>
    </Grid>
</UserControl>
