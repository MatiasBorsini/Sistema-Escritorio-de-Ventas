<UserControl x:Class="LocalInfantil.Wpf.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views"
             AutomationProperties.Name="Punto de venta">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,12,20,18">
            <Grid Margin="0,0,0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Punto de venta"/>
                <Button Grid.Column="1" HorizontalAlignment="Right" Padding="12,0" MinHeight="32"
                        Style="{StaticResource EstiloBotonSecundario}"
                        Content="Cancelar venta" Command="{Binding SolicitarCancelarCommand}"
                        Visibility="{Binding PuedeCancelarVenta, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Solicita confirmación antes de descartar el carrito"/>
            </Grid>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Escaneá una etiqueta o buscá un producto, agregalo al carrito y cobrá." Margin="0,0,0,8"/>

            <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>

            <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource Color.SuccessBgBrush}"
                    BorderBrush="{StaticResource Color.SuccessTextBrush}" BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding UltimoNumero, Converter={StaticResource NullToVisibility}}">
                <DockPanel>
                    <StackPanel>
                        <TextBlock FontWeight="Bold" Foreground="{StaticResource Color.SuccessTextBrush}"
                                   Text="{Binding UltimoNumero, StringFormat=VENTA {0} REALIZADA}"/>
                        <TextBlock Foreground="{StaticResource Color.TextBrush}"
                                   Text="{Binding UltimoTotal, Converter={StaticResource MinorToArs}, StringFormat=Total {0}}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Nueva venta" Command="{Binding NuevaVentaCommand}"/>
                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Ver comprobante" Command="{Binding VerTicketCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Margin="0,0,0,8" Padding="10" Background="{StaticResource Color.WarningBgBrush}"
                    BorderBrush="{StaticResource Color.WarningTextBrush}" BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding ConfirmacionCancelarVisible, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Color.WarningTextBrush}"
                               Text="El carrito tiene líneas. ¿Cancelar la venta? No se guardó nada." TextWrapping="Wrap"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Sí, cancelar" Command="{Binding ConfirmarCancelarCommand}"/>
                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Seguir vendiendo" Command="{Binding CancelarCancelarCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,0,0,8"
                    IsEnabled="{Binding PuedeEditarVenta}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Escanear código o buscar producto" Margin="0,0,0,4"/>
                    <views:BuscadorAsistido x:Name="Buscador" Height="{StaticResource AlturaCampo}"
                                            Modo="Variante" Motor="{Binding MotorSugerencias}"
                                            AutomationProperties.Name="Escanear código o buscar producto"
                                            PatronCodigoExactoEnEnter="^[A-Za-z]{2,5}-[0-9]{3}-[A-Za-z0-9-]+$"
                                            SeleccionCommand="{Binding SeleccionarSugerenciaCommand}"
                                            BusquedaDirectaCommand="{Binding BuscarDirectaCommand}"
                                            Placeholder="Escaneá una etiqueta o escribí código / nombre..."
                                            ToolTip="Enter agrega el código exacto o la única coincidencia; con varias opciones, elegí una"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource EstiloTarjeta}" Padding="10" Margin="0,0,0,8"
                    IsEnabled="{Binding PuedeEditarVenta}"
                    Visibility="{Binding PuedeAsociarCliente, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource EstiloEtiqueta}" Text="CLIENTE OPCIONAL" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                Text="Sin cliente" Visibility="{Binding SinClienteSeleccionado, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Grid.Column="3" HorizontalAlignment="Left" Style="{StaticResource EstiloBotonQuiet}"
                            Content="Asignar cliente" Command="{Binding MostrarBuscadorClienteCommand}"
                            Visibility="{Binding MostrarBotonAsignarCliente, Converter={StaticResource BoolToVisibility}}"/>
                    <views:BuscadorCliente Grid.Column="2" Width="340" HorizontalAlignment="Left"
                                           Motor="{Binding MotorClientes}" SeleccionCommand="{Binding SeleccionarClienteCommand}"
                                           Visibility="{Binding MostrarBuscadorCliente, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding ClienteSeleccionado.NombreCompleto}"
                               Visibility="{Binding ClienteSeleccionado, Converter={StaticResource NullToVisibility}}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Visibility="{Binding PuedeQuitarCliente, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="Cambiar" Command="{Binding CambiarClienteCommand}"/>
                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="Quitar" Command="{Binding LimpiarClienteCommand}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}"
                    IsEnabled="{Binding PuedeEditarVenta}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Carrito" VerticalAlignment="Center"/>
                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       Text="{Binding ResumenCarrito}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource Color.PrimaryBrush}"
                                   Text="{Binding Total, Converter={StaticResource MinorToArs}, StringFormat=Total {0}}"/>
                    </Grid>

                    <TextBlock Text="Escaneá una etiqueta o buscá un producto para comenzar." Margin="0,12,0,14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource EstiloEstadoVacio}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayLineas}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" ItemsSource="{Binding Filas}"
                              BorderBrush="{StaticResource Color.BorderBrush}" MaxHeight="340">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource EstiloGrillaOperativa}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HayLineas}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="1.5*" MinWidth="100"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding CodigoInterno}" Width="90"/>
                            <DataGridTextColumn Header="Talle / Color" Binding="{Binding DetalleTalleColor}" Width="90"/>
                            <DataGridTemplateColumn Header="Cantidad" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource EstiloBotonQuiet}" Content="−" Width="36" MinHeight="34" FontSize="16" Command="{Binding DataContext.DecrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Restar una unidad"/>
                                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="48" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                            <Button Style="{StaticResource EstiloBotonQuiet}" Content="+" Width="36" MinHeight="34" FontSize="16" Command="{Binding DataContext.IncrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Sumar una unidad"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitarioMinor, Converter={StaticResource MinorToArs}}" Width="90"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="✕" ToolTip="Quitar del carrito"
                                                Command="{Binding DataContext.QuitarFilaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Style="{StaticResource EstiloBotonPrimario}" HorizontalAlignment="Right"
                            Content="{Binding Total, Converter={StaticResource MinorToArs}, StringFormat=Cobrar {0}}" Command="{Binding AbrirCobroCommand}"
                            IsEnabled="{Binding PuedeAbrirCobro}" Margin="0,10,0,0"
                            MinHeight="{StaticResource AlturaToolbar}" MinWidth="190"
                            Visibility="{Binding MostrarCtaCobrar, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" Margin="0,8,0,0"
                    Visibility="{Binding CobroVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,7">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Cobro" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonSecundario}" Content="Volver al carrito"
                                Command="{Binding CerrarCobroCommand}" IsEnabled="{Binding PuedeCerrarCobro}"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="+ Agregar medio" Command="{Binding AgregarPagoCommand}"
                                IsEnabled="{Binding PuedeEditarVenta}"/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Pagos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Medio de pago" Margin="0,0,8,3"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource EstiloEtiqueta}" Text="Importe" Margin="0,0,8,3"/>
                                        <TextBlock Grid.Column="2" Style="{StaticResource EstiloEtiqueta}" Text="Efectivo recibido" Margin="0,0,8,3"
                                                   Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisibility}}"/>
                                        <ComboBox Grid.Row="1" Style="{StaticResource EstiloCombo}" ItemsSource="{Binding DataContext.MediosDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Texto" SelectedValuePath="Valor" SelectedValue="{Binding Medio}" Margin="0,0,8,0"
                                                  IsEnabled="{Binding DataContext.PuedeEditarVenta, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        </ComboBox>
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource EstiloCampoTexto}"
                                                 Text="{Binding ImporteTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Importe que se cobra con este medio" Margin="0,0,8,0"
                                                 IsEnabled="{Binding DataContext.PuedeEditarVenta, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource EstiloCampoTexto}"
                                                 Text="{Binding RecibidoTexto, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Efectivo entregado por el cliente"
                                                 Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisibility}}" Margin="0,0,8,0"
                                                 IsEnabled="{Binding DataContext.PuedeEditarVenta, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Button Grid.RowSpan="2" Grid.Column="3" Style="{StaticResource EstiloBotonQuiet}" Content="Quitar"
                                                Command="{Binding DataContext.QuitarPagoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" VerticalAlignment="Center"
                                                IsEnabled="{Binding DataContext.PuedeQuitarPago, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,4,0,0" Foreground="{StaticResource Color.ErrorTextBrush}"
                                                   Text="El efectivo recibido debe cubrir el importe aplicado."
                                                   Visibility="{Binding EfectivoInsuficiente, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,4,0,0" Foreground="{StaticResource Color.SuccessTextBrush}"
                                                   Text="{Binding VueltoMinor, Converter={StaticResource MinorToArs}, StringFormat=Vuelto {0}}"
                                                   Visibility="{Binding VueltoPositivo, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="0,4,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                                   Text="Sin vuelto" Visibility="{Binding VueltoCero, Converter={StaticResource BoolToVisibility}}"/>
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Margin="0,5,0,0" FontSize="12"
                                                   Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap"
                                                   Text="{Binding AyudaMedio}"
                                                   Visibility="{Binding MostrarAyudaMedio, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource Color.Surface2Brush}" CornerRadius="4" Padding="8" Margin="0,0,0,7"
                            Visibility="{Binding MostrarAyudaPoint, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding AyudaPoint}"/>
                    </Border>

                    <Border Background="{StaticResource Color.Surface2Brush}" CornerRadius="5" Padding="10" Margin="0,2,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="TOTAL DE VENTA"/>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}"
                                           Text="{Binding Total, Converter={StaticResource MinorToArs}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                <TextBlock Foreground="{StaticResource Color.TextBrush}" FontWeight="SemiBold" Text="{Binding TextoEstadoPago}"/>
                                <TextBlock Foreground="{StaticResource Color.SuccessTextBrush}" Text="{Binding TextoVuelto}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource Color.TextBrush}"
                                       Text="{Binding ClienteSeleccionado.NombreCompleto, StringFormat=Cliente: {0}}"
                                       Visibility="{Binding MostrarOpcionesFiado, Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                    </Border>

                    <Border Margin="0,8,0,0" Padding="8" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="5"
                            IsEnabled="{Binding PuedeEditarVenta}"
                            Visibility="{Binding MostrarOpcionesFiado, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="FORMA DE PAGO"/>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding SaldoClienteMinor, Converter={StaticResource MinorToArs}, StringFormat=Saldo del cliente: {0}}"/>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding LimiteClienteMinor, Converter={StaticResource MinorToArs}, StringFormat=Límite: {0}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <RadioButton Content="Pago completo" IsChecked="{Binding EsFiado, Converter={StaticResource BoolInvertido}}" Margin="0,0,14,0"/>
                                <RadioButton Content="Cuenta corriente" IsChecked="{Binding EsFiado}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding EsFiado, Converter={StaticResource BoolToVisibility}}">
                                <DatePicker SelectedDate="{Binding Vencimiento}" Margin="0,5,0,0" ToolTip="Vencimiento informativo, opcional"/>
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding DeudaNuevaMinor, Converter={StaticResource MinorToArs}, StringFormat=Queda en cuenta: {0}}" Margin="0,4,0,0"/>
                                <TextBlock Foreground="{StaticResource Color.TextBrush}" FontWeight="SemiBold" Text="{Binding SaldoPosteriorMinor, Converter={StaticResource MinorToArs}, StringFormat=Saldo posterior: {0}}"/>
                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding DisponibleCreditoMinor, Converter={StaticResource MinorToArs}, StringFormat=Disponible de crédito: {0}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar venta" Command="{Binding ConfirmarCommand}"
                                IsEnabled="{Binding PuedeConfirmar}" MinHeight="{StaticResource AlturaToolbar}"
                                Visibility="{Binding TieneMercadoPago, Converter={StaticResource BoolToVisibilityInverted}}"/>
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="{Binding TextoAccionPoint}" Command="{Binding CobrarEnPointCommand}"
                                IsEnabled="{Binding PuedeCobrarPoint}" MinHeight="{StaticResource AlturaToolbar}"
                                Visibility="{Binding TieneMercadoPago, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar cobro" Command="{Binding CancelarCobroPointCommand}"
                                IsEnabled="{Binding PuedeCancelarCobro}" Margin="8,0,0,0"
                            Visibility="{Binding CobroEnCurso, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Color.TextBrush}"
                               Text="{Binding EstadoCobroMp}" TextWrapping="Wrap"
                               Visibility="{Binding EstadoCobroMp, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
