<UserControl x:Class="LocalInfantil.Wpf.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0">
            <DockPanel Margin="0,0,0,2">
                <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Punto de venta" Margin="0,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar venta" Command="{Binding SolicitarCancelarCommand}" ToolTip="Limpia el carrito (pide confirmación si tiene líneas)"/>
                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Nueva venta" Command="{Binding NuevaVentaCommand}" ToolTip="Limpia el carrito directamente" Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Buscá por código interno o nombre, agregá al carrito y cobrá. El stock se descuenta solo al confirmar." Margin="0,0,0,2"/>
            <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
            <Border Margin="0,0,0,4" Padding="12" Background="{StaticResource Color.SuccessBgBrush}" BorderBrush="{StaticResource Color.SuccessTextBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding UltimoNumero, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource Color.SuccessTextBrush}" Text="{Binding UltimoNumero, StringFormat=VENTA {0} REALIZADA}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextBrush}" Text="{Binding UltimoTotal, Converter={StaticResource MinorToArs}, StringFormat=Total {0}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Nueva venta" Command="{Binding NuevaVentaCommand}"/>
                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Ver comprobante" Command="{Binding VerTicketCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,4" Padding="12" Background="{StaticResource Color.WarningBgBrush}" BorderBrush="{StaticResource Color.WarningTextBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding ConfirmacionCancelarVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource Color.WarningTextBrush}" TextWrapping="Wrap" Text="El carrito tiene líneas. ¿Cancelar la venta? No se guardó nada."/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Sí, cancelar" Command="{Binding ConfirmarCancelarCommand}"/>
                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Seguir vendiendo" Command="{Binding CancelarCancelarCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <Grid Margin="20,2,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Margin="0,0,12,0" Padding="{StaticResource RellenoPanel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <StackPanel Style="{StaticResource EstiloToolbar}" Orientation="Horizontal" Margin="0,0,0,4">
                            <views:BuscadorAsistido x:Name="Buscador" Width="300" Modo="Variante" Motor="{Binding MotorSugerencias}"
                                                    SeleccionCommand="{Binding SeleccionarSugerenciaCommand}"
                                                    BusquedaDirectaCommand="{Binding BuscarDirectaCommand}"
                                                    ToolTip="Código interno o nombre de producto (Enter agrega directo)"/>
                        </StackPanel>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="{Binding Total, Converter={StaticResource MinorToArs}, StringFormat=Total {0}}" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Filas.Count, StringFormat={}{0} línea(s)}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid Style="{StaticResource EstiloGrillaOperativa}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                              CanUserSortColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              ItemsSource="{Binding Filas}" BorderBrush="{StaticResource Color.BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="2*" MinWidth="140"/>
                            <DataGridTextColumn Header="Código" Binding="{Binding CodigoInterno}" Width="110"/>
                            <DataGridTextColumn Header="Talle / Color" Binding="{Binding DetalleTalleColor}" Width="110"/>
                            <DataGridTemplateColumn Header="Cantidad" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource EstiloBotonQuiet}" Content="−" Width="26" Command="{Binding DataContext.DecrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <TextBox Style="{StaticResource EstiloCampoTexto}" Width="48" Text="{Binding CantidadTexto, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center"/>
                                            <Button Style="{StaticResource EstiloBotonQuiet}" Content="+" Width="26" Command="{Binding DataContext.IncrementarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnitarioMinor, Converter={StaticResource MinorToArs}}" Width="95"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalMinor, Converter={StaticResource MinorToArs}}" Width="100"/>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="✕" ToolTip="Quitar del carrito" Command="{Binding DataContext.QuitarFilaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Margin="0" Padding="{StaticResource RellenoPanel}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Cobro" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="+ Medio" Command="{Binding AgregarPagoCommand}"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="− Medio" Command="{Binding QuitarPagoCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Pagos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <ComboBox Style="{StaticResource EstiloCombo}" ItemsSource="{Binding DataContext.MediosDisponibles, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Medio}"/>
                                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding ImporteTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Importe imputado (Ej: 1234,50)" Margin="0,6,0,0"/>
                                            <StackPanel Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding RecibidoTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Efectivo entregado por el cliente" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Total" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Total, Converter={StaticResource MinorToArs}}"/>
                            <TextBlock Grid.Row="1" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Pagado" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Pagado, Converter={StaticResource MinorToArs}}"/>
                            <TextBlock Grid.Row="2" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Restante" Margin="0,0,8,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Restante, Converter={StaticResource MinorToArs}}"/>
                            <TextBlock Grid.Row="3" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Vuelto" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.SuccessTextBrush}" Text="{Binding VueltoTotal, Converter={StaticResource MinorToArs}, FallbackValue=—}"/>
                        </Grid>
                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar venta" Command="{Binding ConfirmarCommand}" IsEnabled="{Binding PuedeConfirmar}" HorizontalAlignment="Stretch" Margin="0,10,0,0" MinHeight="{StaticResource AlturaToolbar}"/>
                        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Al confirmar se descuenta stock Disponible. No hay venta en espera." TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
