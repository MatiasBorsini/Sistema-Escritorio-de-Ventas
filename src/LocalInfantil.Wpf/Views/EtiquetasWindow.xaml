<Window x:Class="LocalInfantil.Wpf.Views.EtiquetasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Imprimir etiquetas" Width="1030" Height="660" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Color.BackgroundBrush}">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Imprimir etiquetas" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}"/>
            <TextBlock Text="{Binding NombreProducto}" Margin="0,2,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Color.DangerTextBrush}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Poner stock disponible" Style="{StaticResource EstiloBotonSecundario}" Command="{Binding PonerStockDisponibleCommand}" Margin="0,0,6,0"/>
                <Button Content="Limpiar cantidades" Style="{StaticResource EstiloBotonQuiet}" Command="{Binding LimpiarCantidadesCommand}" Margin="0,0,14,0"/>
                <Button Content="Vista previa" Style="{StaticResource EstiloBotonSecundario}" Click="VistaPrevia_Click"/>
                <Button Content="Imprimir…" Style="{StaticResource EstiloBotonPrimario}" Click="Imprimir_Click" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Filas}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" Margin="0,0,12,0" BorderBrush="{StaticResource Color.BorderBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Código" Binding="{Binding Variante.CodigoInterno}" IsReadOnly="True" Width="135"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Variante.NombreProducto}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Variante" Binding="{Binding VarianteTexto}" IsReadOnly="True" Width="100"/>
                    <DataGridTextColumn Header="Disponible" Binding="{Binding Variante.Disponible}" IsReadOnly="True" Width="85"/>
                    <DataGridTextColumn Header="Etiquetas" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Diseño y página" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Margin="0,0,0,8"/>
                    <CheckBox Content="Mostrar precio vigente" IsChecked="{Binding MostrarPrecio}" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <TextBlock Text="Ancho (mm)"/><TextBox Text="{Binding AnchoMm, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Alto (mm)"/><TextBox Text="{Binding AltoMm, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Margen horiz. (mm)"/><TextBox Text="{Binding MargenHorizontalMm, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Margen vert. (mm)"/><TextBox Text="{Binding MargenVerticalMm, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Separación horiz."/><TextBox Text="{Binding SeparacionHorizontalMm, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Separación vert."/><TextBox Text="{Binding SeparacionVerticalMm, UpdateSourceTrigger=LostFocus}"/>
                    </UniformGrid>
                    <Border Background="{StaticResource Color.SurfaceBrush}" Padding="10" Margin="0,12,0,0" CornerRadius="6">
                        <TextBlock Text="Valores de desarrollo editables. Confirmá tamaño y calibración con la impresora real antes de usarlos en el local." TextWrapping="Wrap" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
