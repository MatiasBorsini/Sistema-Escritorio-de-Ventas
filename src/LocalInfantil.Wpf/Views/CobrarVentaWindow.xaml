<Window x:Class="LocalInfantil.Wpf.Views.CobrarVentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar venta" Width="1000" MinWidth="760" MinHeight="400" MaxHeight="700"
        SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Color.SurfaceBrush}" Closing="Window_Closing"
        AutomationProperties.Name="Cobrar venta">
    <Window.Resources>
        <FontFamily x:Key="FuenteIcono">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
        <Style x:Key="EstiloTarjetaModalidad" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Tarjeta" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border x:Name="Indicador" Width="17" Height="17" CornerRadius="9" BorderThickness="1.5"
                                        BorderBrush="{StaticResource Color.TextSecondaryBrush}" VerticalAlignment="Top" Margin="0,1,8,0">
                                    <TextBlock x:Name="Marca" Text="✓" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Color.CanvasBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                                <Setter TargetName="Tarjeta" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Indicador" Property="Background" Value="{StaticResource Color.PrimaryBrush}"/>
                                <Setter TargetName="Indicador" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14,10,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource Color.TextBrush}" Text="Cobrar venta"/>
                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Revisá cómo paga el cliente y confirmá la venta."/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Color.Surface2Brush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="16" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="&#xE77B;" Margin="0,0,8,0"/>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding ClienteSeleccionado.NombreCompleto}"/>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Sin cliente" Visibility="{Binding SinClienteSeleccionado, Converter={StaticResource BoolToVisibility}}"/>
                    <Border Width="1" Height="26" Background="{StaticResource Color.BorderBrush}" Margin="14,0"/>
                    <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" VerticalAlignment="Center" Text="{Binding ResumenCarrito}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Color.SurfaceBrush}" CornerRadius="5" Padding="12,5">
                    <StackPanel HorizontalAlignment="Right">
                        <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" HorizontalAlignment="Right" Text="TOTAL"/>
                        <TextBlock FontSize="21" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}"
                                   Text="{Binding Total, Converter={StaticResource MinorToArs}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,5" Text="¿Cómo paga el cliente?"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" GroupName="ModalidadCobro" Style="{StaticResource EstiloTarjetaModalidad}"
                             IsChecked="{Binding EsFiado, Converter={StaticResource BoolInvertido}, Mode=TwoWay}"
                             IsEnabled="{Binding PuedeEditarModalidad}" Margin="0,0,5,0">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Paga todo ahora"/>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Se cobra el total de la venta." TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="1" GroupName="ModalidadCobro" Style="{StaticResource EstiloTarjetaModalidad}"
                             IsChecked="{Binding ModalidadFiadoTotalSeleccionada, Mode=OneWay}" Command="{Binding ElegirFiadoTotalCommand}"
                             IsEnabled="{Binding MostrarOpcionesFiado}" Margin="2,0">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Toda la venta a cuenta"/>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="No se cobra ahora; se registra la deuda." TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton Grid.Column="2" GroupName="ModalidadCobro" Style="{StaticResource EstiloTarjetaModalidad}"
                             IsChecked="{Binding ModalidadFiadoParcialSeleccionada, Mode=OneWay}" Command="{Binding MostrarCobroParcialCommand}"
                             IsEnabled="{Binding MostrarOpcionesFiado}" Margin="5,0,0,0">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Pago parcial y resto a cuenta"/>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Elegí cuánto se cobra ahora." TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </Grid>
            <Border Margin="0,5,0,0" Padding="6,4" CornerRadius="4" Background="{StaticResource Color.Surface2Brush}"
                    Visibility="{Binding MostrarAvisoFiadoNoDisponible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding MotivoFiadoNoDisponible}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Padding="10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,7" Visibility="{Binding MostrarDistribucionPago, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Medios para cobrar ahora" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource EstiloBotonSecundario}" Padding="9,0" MinHeight="28" Content="+ Agregar medio" Command="{Binding AgregarPagoCommand}"/>
                    </Grid>
                    <DockPanel Grid.Row="1" Margin="0,0,0,6" Visibility="{Binding MostrarDistribucionPago, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Aún sin asignar" Foreground="{StaticResource Color.TextSecondaryBrush}"/>
                        <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding ImporteSinAsignarMinor, Converter={StaticResource MinorToArs}}"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="2" MaxHeight="290" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding MostrarDistribucionPago, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding Pagos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Medio de pago" Margin="0,0,8,3"/>
                                            <TextBlock Grid.Column="1" Style="{StaticResource EstiloEtiqueta}" Text="Importe" Margin="0,0,8,3"/>
                                            <Button Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Style="{StaticResource EstiloBotonQuiet}" Content="Quitar"
                                                    Command="{Binding DataContext.QuitarPagoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.PuedeQuitarPago, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            <ComboBox Grid.Row="1" Style="{StaticResource EstiloCombo}" ItemsSource="{Binding DataContext.MediosDisponibles, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      DisplayMemberPath="Texto" SelectedValuePath="Valor" SelectedValue="{Binding Medio}" Margin="0,0,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource EstiloCampoTexto}"
                                                     Text="{Binding ImporteTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Importe asignado a este medio" Margin="0,0,8,0"/>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,0">
                                                <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding AyudaMedio}"
                                                           Visibility="{Binding MostrarAyudaMedio, Converter={StaticResource BoolToVisibility}}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Efectivo recibido" VerticalAlignment="Center" Margin="0,0,9,0"
                                                               Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBox Width="120" VerticalAlignment="Center" Style="{StaticResource EstiloCampoTexto}"
                                                             Text="{Binding RecibidoTexto, UpdateSourceTrigger=PropertyChanged}" ToolTip="Dinero físico entregado por el cliente"
                                                             Visibility="{Binding EsEfectivo, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource Color.TextSecondaryBrush}" Text="No hace falta cobrar ahora; la venta completa quedará en cuenta corriente."
                               Visibility="{Binding MostrarDistribucionPago, Converter={StaticResource BoolToVisibilityInverted}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Padding="10" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Resumen del cobro" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="A cobrar ahora:"/>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CobradoAhoraMinor, Converter={StaticResource MinorToArs}}"/>
                    </Grid>
                    <StackPanel Visibility="{Binding MostrarResumenCuentaCobro, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Deuda nueva:"/>
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding DeudaNuevaMinor, Converter={StaticResource MinorToArs}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Crédito disponible después:"/>
                            <TextBlock Grid.Column="1" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding DisponibleCreditoPosteriorMostradoMinor, Converter={StaticResource MinorToArs}}"/>
                        </Grid>
                        <Expander Header="Ver saldo y límite" Margin="0,0,0,3">
                            <Grid Margin="4,2,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Saldo anterior"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding SaldoClienteMinor, Converter={StaticResource MinorToArs}}"/>
                                <TextBlock Grid.Row="1" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Saldo posterior"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding SaldoPosteriorMinor, Converter={StaticResource MinorToArs}}"/>
                                <TextBlock Grid.Row="2" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Límite autorizado"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding LimiteClienteMinor, Converter={StaticResource MinorToArs}}"/>
                            </Grid>
                        </Expander>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Vencimiento (opcional)" Margin="0,1,0,2"/>
                        <DatePicker SelectedDate="{Binding Vencimiento}" ToolTip="Vencimiento informativo, opcional"/>
                    </StackPanel>
                    <Border Background="{StaticResource Color.Surface2Brush}" CornerRadius="5" Padding="7,5" Margin="0,5,0,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" TextWrapping="Wrap" Text="{Binding TextoEstadoPago}"/>
                    </Border>
                    <TextBlock FontSize="12" Foreground="{StaticResource Color.SuccessTextBrush}" Text="{Binding TextoVuelto}" Margin="0,3,0,0"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource Color.WarningTextBrush}" TextWrapping="Wrap" Text="{Binding EstadoCobroMp}" Margin="0,4,0,0"
                               Visibility="{Binding EstadoCobroMp, Converter={StaticResource NullToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Error}" Foreground="{StaticResource Color.WarningTextBrush}" TextWrapping="Wrap" Margin="0,0,0,6">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Grid.Row="1">
                <Button HorizontalAlignment="Left" Style="{StaticResource EstiloBotonSecundario}" Content="Volver al carrito" MinHeight="40" Padding="18,0" Click="VolverCarrito_Click"
                        IsEnabled="{Binding PuedeCerrarCobro}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar cobro" Command="{Binding CancelarCobroPointCommand}"
                            IsEnabled="{Binding PuedeCancelarCobro}" Margin="0,0,8,0" Visibility="{Binding CobroEnCurso, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar venta" Command="{Binding ConfirmarCommand}"
                            IsEnabled="{Binding PuedeConfirmar}" MinHeight="40" MinWidth="220" FontSize="15" FontWeight="Bold"
                            Visibility="{Binding TieneMercadoPago, Converter={StaticResource BoolToVisibilityInverted}}"/>
                    <Button Style="{StaticResource EstiloBotonPrimario}" Content="{Binding TextoAccionPoint}" Command="{Binding CobrarEnPointCommand}"
                            IsEnabled="{Binding PuedeCobrarPoint}" MinHeight="40" MinWidth="220" FontWeight="Bold"
                            Visibility="{Binding MostrarAccionPointIntegrada, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Style="{StaticResource EstiloBotonPrimario}" Content="{Binding TextoAccionManual}" Command="{Binding RegistrarCobroManualCommand}"
                            IsEnabled="{Binding PuedeRegistrarCobroManual}" MinHeight="40" MinWidth="220" FontWeight="Bold"
                            Visibility="{Binding MostrarAccionPointManual, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
