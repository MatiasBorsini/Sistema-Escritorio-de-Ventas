<UserControl x:Class="LocalInfantil.Wpf.Views.EstadoPrototipoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="640">
        <TextBlock Foreground="#4B5563"
                   Text="Resumen ficticio de la estructura actual. No representa datos del local."
                   TextWrapping="Wrap" />
        <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Elementos}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,8" Padding="12" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Nombre}" />
                            <TextBlock Grid.Column="1" Text="{Binding Estado}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Margin="0,10,0,0" Padding="12" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Comprobación técnica de SQLite" />
                <TextBlock Margin="0,6,0,10"
                           Foreground="#374151"
                           Text="Guarda y recupera un valor técnico local. No utiliza datos del comercio ni requiere internet."
                           TextWrapping="Wrap" />
                <Button Width="260"
                        HorizontalAlignment="Left"
                        Command="{Binding ComprobarPersistenciaCommand}"
                        Content="Comprobar persistencia local" />
                <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="{Binding EstadoComprobacion}" TextWrapping="Wrap" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Escritura" />
                    <TextBlock Grid.Column="1" Text="{Binding EstadoEscritura}" />
                    <TextBlock Grid.Row="1" Text="Lectura" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EstadoLectura}" />
                    <TextBlock Grid.Row="2" Text="Dato coincide" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EstadoCoincidencia}" />
                </Grid>
                <TextBlock Margin="0,10,0,0"
                           Foreground="#B91C1C"
                           Text="{Binding MensajeError}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Margin="0,10,0,0" Padding="12" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Impresión de prueba" />
                <TextBlock Margin="0,6,0,10"
                           Foreground="#374151"
                           Text="Abre un documento ficticio para revisarlo antes de elegir una impresora. No registra ventas ni emite facturas."
                           TextWrapping="Wrap" />
                <Button Width="260"
                        HorizontalAlignment="Left"
                        Command="{Binding AbrirVistaPreviaImpresionCommand}"
                        Content="Ver vista previa de impresión" />
                <TextBlock Margin="0,10,0,0" Text="{Binding EstadoImpresion}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
