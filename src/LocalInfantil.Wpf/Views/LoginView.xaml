<UserControl x:Class="LocalInfantil.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="360" Margin="24">
        <Image Source="{StaticResource LogoBannerTiNA}"
               Width="340" Height="68" Stretch="Uniform" HorizontalAlignment="Center"
               Margin="0,0,0,12" AutomationProperties.Name="TiNA kids — Vistiendo sonrisas"/>
        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Iniciar sesión" Margin="0,4,0,0"/>
        <TextBlock Style="{StaticResource EstiloAyuda}" Text="Usá tu usuario y contraseña del sistema." Margin="0,4,0,20"/>
        <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Usuario"/>
        <TextBox x:Name="CampoUsuario" Style="{StaticResource EstiloCampoTextoGrande}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Contraseña"/>
        <PasswordBox x:Name="Pwd" MinHeight="44" FontSize="15" Padding="8,4" VerticalContentAlignment="Center" BorderBrush="{StaticResource Color.BorderBrush}" PasswordChanged="Pwd_PasswordChanged" Margin="0,0,0,8"/>
        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Enter para ingresar" Margin="0,0,0,12"/>
        <Button Content="Ingresar" Style="{StaticResource EstiloBotonPrimario}" Command="{Binding IngresarCommand}" IsDefault="True" HorizontalAlignment="Stretch" MinHeight="44" Margin="0,0,0,0"/>
        <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}" Margin="0,12,0,0"/>
        <Border Height="1" Background="{StaticResource Color.BorderSoftBrush}" Margin="0,16,0,12"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="9" Height="9" Fill="{StaticResource Color.WarningTextBrush}" VerticalAlignment="Center"/>
            <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Sin internet · Sesión local" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
