<UserControl x:Class="LocalInfantil.Wpf.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <FontFamily x:Key="FuenteIcono">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    </UserControl.Resources>

    <Grid Margin="20,10,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="20" Foreground="{StaticResource Color.PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,9,0" Text="&#xE77B;"/>
                <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Clientes"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource EstiloBotonPrimario}"
                    Content="+ Nuevo cliente" Command="{Binding NuevoCommand}"
                    Visibility="{Binding PuedeAdministrar, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
        </StackPanel>

        <!-- Maestro-detalle -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="65*"/>
            </Grid.ColumnDefinitions>

            <!-- IZQUIERDA: búsqueda reactiva + listado/paginación -->
            <Border Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Buscar por nombre o teléfono" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource EstiloCampoTexto}"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="La búsqueda se aplica mientras escribís"
                                 AutomationProperties.Name="Buscar clientes"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,8">
                        <CheckBox Content="Incluir inactivos" IsChecked="{Binding IncluirInactivos}" VerticalAlignment="Center"/>
                        <ProgressBar Style="{StaticResource EstiloOcupado}" Width="80" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Style="{StaticResource EstiloGrillaOperativa}"
                              ItemsSource="{Binding Clientes}" SelectedItem="{Binding Seleccionado, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="None"
                              Background="{StaticResource Color.SurfaceBrush}"
                              VerticalAlignment="Top" MaxHeight="460" MinHeight="52"
                              AutomationProperties.Name="Listado de clientes">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding NombreCompleto}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Telefono, TargetNullValue=Sin teléfono}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" CornerRadius="10" Padding="8,3"
                                                    Background="{StaticResource Color.Surface2Brush}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="Activo">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Color.PrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                                                                    <Setter Property="Text" Value="Inactivo"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource Color.TextSecondaryBrush}" Text="No hay clientes para mostrar."
                               Visibility="{Binding Clientes.Count, Converter={StaticResource CeroVisible}}"/>

                    <DockPanel Grid.Row="3" Margin="0,6,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource EstiloBotonQuiet}" Content="‹ Anterior" Command="{Binding AnteriorCommand}" IsEnabled="{Binding HayAnterior}"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource EstiloBotonQuiet}" Content="Siguiente ›" Command="{Binding SiguienteCommand}" IsEnabled="{Binding HaySiguiente}" Margin="8,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding TextoPagina}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- DERECHA: ficha en modo consulta + formulario sólo al editarlo -->
            <Border Grid.Column="2" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Estado vacío -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,24"
                                    Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVisibilityInverted}}">
                            <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource Color.BorderSoftBrush}" HorizontalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="19" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                           Text="&#xE77B;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Margin="0,10,0,0" TextAlignment="Center" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                       Text="Seleccioná un cliente para consultar sus datos e historial."/>
                        </StackPanel>

                        <!-- Ficha (consulta por defecto) -->
                        <Grid Grid.Row="0" Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Color.BorderSoftBrush}" VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="16" Foreground="{StaticResource Color.PrimaryBrush}"
                                                   Text="&#xE77B;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Seleccionado.NombreCompleto}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}"
                                                   Text="{Binding Seleccionado.Telefono, TargetNullValue=Sin teléfono}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="8,3" Background="{StaticResource Color.Surface2Brush}">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding EstadoSeleccion}"/>
                                </Border>
                            </Grid>
                            <DockPanel Grid.Row="1" Margin="46,4,0,0"
                                       Visibility="{Binding Seleccionado.Observacion, Converter={StaticResource NullToVisibility}}">
                                <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold" Margin="0,0,5,0" Text="Observación:"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Color.TextSecondaryBrush}"
                                           Text="{Binding Seleccionado.Observacion}"/>
                            </DockPanel>

                            <!-- Datos clave + cuenta corriente (patrón de Cuenta corriente) -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Visibility="{Binding PuedeConsultarCuenta, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Saldo pendiente"/>
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Color.AccentBrush}"
                                               Text="{Binding ResumenCuenta.SaldoMinor, Converter={StaticResource MinorToArs}, TargetNullValue=—}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" Visibility="{Binding PuedeConsultarCuenta, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Límite autorizado"/>
                                    <TextBlock FontWeight="SemiBold" Text="Fiado no habilitado">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResumenCuenta.LimiteMinor}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding ResumenCuenta.LimiteMinor, Converter={StaticResource MinorToArs}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResumenCuenta.LimiteMinor}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" Visibility="{Binding PuedeConsultarCuenta, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Crédito disponible">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResumenCuenta.LimiteMinor}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding ResumenCuenta.DisponibleMinor, Converter={StaticResource MinorToArs}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResumenCuenta.LimiteMinor}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Acciones sobre el cliente -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="{Binding PuedeAdministrar, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Editar datos" Command="{Binding EditarCommand}"
                                        IsEnabled="{Binding Seleccionado.Activo}"/>
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="{Binding TextoAccionEstado}" Command="{Binding CambiarActivoCommand}"
                                        Margin="8,0,0,0"
                                        Visibility="{Binding ConfirmacionDesactivacionVisible, Converter={StaticResource BoolToVisibilityInverted}}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Confirmación de desactivación -->
                        <Border Grid.Row="1" Margin="0,6,0,0" Padding="8" Background="{StaticResource Color.WarningBgBrush}" CornerRadius="6"
                                Visibility="{Binding ConfirmacionDesactivacionVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource Color.WarningTextBrush}" TextWrapping="Wrap"
                                           Text="Se desactivará para nuevas ventas; las ventas e historial se conservarán."/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar desactivación" Command="{Binding ConfirmarDesactivacionCommand}"/>
                                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarDesactivacionCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Formulario de alta/edición: sólo cuando se lo pide -->
                        <Border Grid.Row="2" Margin="0,8,0,0" Padding="9" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="6"
                                Visibility="{Binding FormularioVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="{Binding TituloFormulario}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource EstiloBotonQuiet}" Content="Cerrar sin guardar ↩"
                                            Command="{Binding CancelarEdicionCommand}" ToolTip="Descarta los cambios de este formulario"/>
                                </Grid>
                                <TextBlock Foreground="{StaticResource Color.WarningTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Hay cambios sin guardar. Se descartarán solo si confirmás esta acción."
                                           Visibility="{Binding ConfirmacionCambiosVisible, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Nombre completo *" Margin="0,6,0,2"/>
                                <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Teléfono" Margin="0,6,0,2"/>
                                <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Observación" Margin="0,6,0,2"/>
                                <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource EstiloBotonPrimario}" Content="Guardar" Command="{Binding GuardarCommand}" IsEnabled="{Binding !Ocupado}"/>
                                    <Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarEdicionCommand}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Border Margin="0,8,0,0" Padding="8" Background="{StaticResource Color.Surface2Brush}" CornerRadius="4"
                                        Visibility="{Binding ConfirmacionCambiosVisible, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Descartar cambios" Command="{Binding ConfirmarPerderCambiosCommand}"/>
                                        <Button Style="{StaticResource EstiloBotonPrimario}" Content="Seguir editando" Command="{Binding VolverAEditarCommand}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Historiales -->
                        <StackPanel Grid.Row="4" Margin="0,8,0,0">
                            <Border BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Historial de ventas y cambios" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Historial}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Left" Width="126" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Fecha}"/>
                                                    <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Sin ventas ni cambios registrados." Margin="0,1,0,0" Visibility="{Binding Historial.Count, Converter={StaticResource CeroVisible}}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0"
                                    Visibility="{Binding PuedeConsultarCuenta, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Movimientos de cuenta corriente" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding HistorialCuenta}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock DockPanel.Dock="Left" Width="126" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Fecha}"/>
                                                    <TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Sin movimientos de cuenta corriente." Margin="0,1,0,0" Visibility="{Binding HistorialCuenta.Count, Converter={StaticResource CeroVisible}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
