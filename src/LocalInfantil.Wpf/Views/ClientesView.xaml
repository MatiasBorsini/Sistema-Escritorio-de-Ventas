<UserControl x:Class="LocalInfantil.Wpf.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,8">
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Clientes"/>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Contactos asociados a ventas; no registra saldos ni ventas a cuenta."/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
        </StackPanel>
        <Grid Margin="20,0,20,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonPrimario}" Content="+ Nuevo cliente" Command="{Binding NuevoCommand}" Visibility="{Binding PuedeAdministrar, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nombre o teléfono"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <CheckBox Content="Incluir inactivos" IsChecked="{Binding IncluirInactivos}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Style="{StaticResource EstiloBotonSecundario}" Content="Buscar" Command="{Binding BuscarCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource EstiloBotonQuiet}" Content="Siguiente ›" Command="{Binding SiguienteCommand}" IsEnabled="{Binding HaySiguiente}"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource EstiloBotonQuiet}" Content="‹ Anterior" Command="{Binding AnteriorCommand}" IsEnabled="{Binding HayAnterior}"/>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding TextoPagina}"/>
                    </DockPanel>
                    <DataGrid Style="{StaticResource EstiloGrillaOperativa}" ItemsSource="{Binding Clientes}" SelectedItem="{Binding Seleccionado, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre completo" Binding="{Binding NombreCompleto}" Width="2*" MinWidth="150"/>
                            <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono, TargetNullValue=—}" Width="*" MinWidth="90"/>
                            <DataGridTemplateColumn Header="Estado" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Activo"/><Style.Triggers><DataTrigger Binding="{Binding Activo}" Value="False"><Setter Property="Text" Value="Inactivo"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource EstiloTarjeta}" Padding="{StaticResource RellenoPanel}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Ficha del cliente"/>
                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding EstadoSeleccion}"/>
                            </DockPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,4,0,2" Text="{Binding Seleccionado.NombreCompleto}"/>
                            <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Seleccionado.Telefono, TargetNullValue=Sin teléfono}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,5,0,10" Text="{Binding Seleccionado.Observacion, TargetNullValue=Sin observaciones}"/>
                            <Border Margin="0,0,0,8" Padding="8" Background="{StaticResource Color.SurfaceBrush}" Visibility="{Binding PuedeConsultarCuenta, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Cuenta corriente"/>
                                    <TextBlock Text="{Binding ResumenCuenta.SaldoMinor, Converter={StaticResource MinorToArs}, StringFormat='Saldo: {0}'}"/>
                                    <TextBlock Text="{Binding ResumenCuenta.LimiteMinor, Converter={StaticResource MinorToArs}, TargetNullValue=No habilitado para fiado, StringFormat='Límite: {0}'}"/>
                                    <TextBlock Text="{Binding ResumenCuenta.DisponibleMinor, Converter={StaticResource MinorToArs}, StringFormat='Disponible: {0}'}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding PuedeAdministrar, Converter={StaticResource BoolToVisibility}}">
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Editar datos" Command="{Binding EditarCommand}" IsEnabled="{Binding Seleccionado.Activo}"/>
                                <Button Style="{StaticResource EstiloBotonSecundario}" Content="{Binding TextoAccionEstado}" Command="{Binding CambiarActivoCommand}" Margin="8,0,0,0" Visibility="{Binding ConfirmacionDesactivacionVisible, Converter={StaticResource BoolToVisibilityInverted}}"/>
                            </StackPanel>
                            <Border Margin="0,0,0,8" Padding="8" Background="{StaticResource Color.WarningBgBrush}" Visibility="{Binding ConfirmacionDesactivacionVisible, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel><TextBlock Text="Se desactivará para nuevas ventas; las ventas e historial se conservarán." TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Style="{StaticResource EstiloBotonPrimario}" Content="Confirmar desactivación" Command="{Binding ConfirmarDesactivacionCommand}"/><Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarDesactivacionCommand}" Margin="8,0,0,0"/></StackPanel></StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Historial de ventas y cambios" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Historial}">
                                        <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="126" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Fecha}"/><TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="No hay movimientos para mostrar." Visibility="{Binding Historial.Count, Converter={StaticResource CeroVisible}}"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0" Visibility="{Binding PuedeConsultarCuenta, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Movimientos de cuenta corriente" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding HistorialCuenta}">
                                        <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><TextBlock DockPanel.Dock="Left" Width="126" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Fecha}"/><TextBlock Text="{Binding Descripcion}" TextWrapping="Wrap"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Sin movimientos de cuenta corriente." Visibility="{Binding HistorialCuenta.Count, Converter={StaticResource CeroVisible}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Seleccioná un cliente para consultar sus datos e historial." TextWrapping="Wrap" Foreground="{StaticResource Color.TextSecondaryBrush}" Visibility="{Binding HaySeleccion, Converter={StaticResource BoolToVisibilityInverted}}"/>
                        <Border Margin="0,8,0,0" Padding="10" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="4" Visibility="{Binding FormularioVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="{Binding TituloFormulario}" Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Nombre completo *"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Teléfono"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                                <TextBlock Style="{StaticResource EstiloEtiqueta}" Text="Observación"/><TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Observacion, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8"/>
                                <StackPanel Orientation="Horizontal"><Button Style="{StaticResource EstiloBotonPrimario}" Content="Guardar" Command="{Binding GuardarCommand}"/><Button Style="{StaticResource EstiloBotonSecundario}" Content="Cancelar" Command="{Binding CancelarEdicionCommand}" Margin="8,0,0,0"/></StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
