<UserControl x:Class="LocalInfantil.Wpf.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="640">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding MensajePrincipal}" TextWrapping="Wrap" />
        <TextBlock Margin="0,10,0,18" Foreground="#4B5563" Text="{Binding MensajeSecundario}" TextWrapping="Wrap" />

        <Border Padding="16" Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
            <ItemsControl ItemsSource="{Binding PuntosDeDemostracion}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,4" Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
