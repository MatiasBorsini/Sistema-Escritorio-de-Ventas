<Window x:Class="LocalInfantil.Wpf.Views.TicketAbonoWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Recibo de abono" Width="440" Height="600" WindowStartupLocation="CenterOwner" Background="White" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
            <TextBlock FontSize="20" FontWeight="Bold" Text="LocalInfantil" TextAlignment="Center"/>
            <TextBlock Margin="0,3,0,12" FontSize="12" FontWeight="Bold" Text="{Binding Leyenda}" TextAlignment="Center"/>
            <TextBlock FontWeight="Bold" Text="{Binding Numero, StringFormat='Recibo {0}'}"/>
            <TextBlock Text="{Binding ClienteNombre}"/><TextBlock Text="{Binding Fecha, Converter={StaticResource FechaCorta}}"/>
            <Separator Margin="0,8"/><DockPanel><TextBlock Text="Importe abonado"/><TextBlock DockPanel.Dock="Right" FontWeight="Bold" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
            <TextBlock Margin="0,8,0,3" FontWeight="SemiBold" Text="Medios de pago"/>
            <ItemsControl ItemsSource="{Binding Pagos}">
                <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2"><TextBlock Text="{Binding Medio}"/><TextBlock DockPanel.Dock="Right" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/></DockPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,8,0,3" FontWeight="SemiBold" Text="Aplicación por venta"/>
            <ItemsControl ItemsSource="{Binding Aplicaciones}">
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,3"><DockPanel><TextBlock Text="{Binding VentaNumero}"/><TextBlock DockPanel.Dock="Right" Text="{Binding ImporteMinor, Converter={StaticResource MinorToArs}}"/></DockPanel><TextBlock FontSize="11" Foreground="Gray" Text="{Binding PendientePosteriorMinor, Converter={StaticResource MinorToArs}, StringFormat='Pendiente luego del abono: {0}'}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <Separator Margin="0,8"/><DockPanel><TextBlock Text="Saldo anterior"/><TextBlock DockPanel.Dock="Right" Text="{Binding SaldoAnteriorMinor, Converter={StaticResource MinorToArs}}"/></DockPanel><DockPanel Margin="0,3"><TextBlock Text="Saldo posterior"/><TextBlock DockPanel.Dock="Right" FontWeight="Bold" Text="{Binding SaldoPosteriorMinor, Converter={StaticResource MinorToArs}}"/></DockPanel>
        </StackPanel></ScrollViewer>
    </DockPanel>
</Window>
