<UserControl x:Class="LocalInfantil.Wpf.Views.PortadaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<UserControl.Resources>
    <FontFamily x:Key="FuenteIcono">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

    <!-- Panel con encabezado real (prototipo: .panel / .panel-head) -->
    <Style x:Key="EstiloPanelInicio" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="EstiloPanelCabeza" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="44"/>
    </Style>
    <Style x:Key="EstiloTituloPanel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EstiloGlifo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteIcono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EstiloPildora" TargetType="Border">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EstiloTextoPildora" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- Acción de texto (links dentro de encabezados de panel) -->
    <Style x:Key="EstiloEnlace" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Color.PrimaryBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.BorderSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Fila de pendiente: fila completa interactiva (prototipo .attention-row) -->
    <Style x:Key="EstiloFilaPendiente" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.BorderSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Tarjeta de indicador compacta (prototipo: tiles con icono + dato) -->
    <Style x:Key="EstiloTarjetaIndicador" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
        <Setter Property="MinHeight" Value="112"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.BorderSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</UserControl.Resources>
<ScrollViewer x:Name="ScrollPortada" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Color.CanvasBrush}">
<Grid Margin="24,16,24,18">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

<StackPanel Grid.Row="0">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Inicio"/>
            <TextBlock FontSize="14" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Bienvenida}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Resumen operativo"/>
            <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Se actualiza al abrir Inicio y cuando cambia algún dato."/>
        </StackPanel>
    </Grid>
    <ProgressBar Style="{StaticResource EstiloOcupado}" Margin="0,8,0,0" Visibility="{Binding Ocupado,Converter={StaticResource BoolToVisibility}}"/>
    <Border Margin="0,8,0,0" Padding="12,8" CornerRadius="6" Background="{StaticResource Color.ErrorBgBrush}" Visibility="{Binding Error,Converter={StaticResource NullToVisibility}}">
        <TextBlock FontSize="13" Foreground="{StaticResource Color.ErrorTextBrush}" TextWrapping="Wrap" Text="{Binding Error}"/>
    </Border>
</StackPanel>

<!-- Nivel 1: indicadores operativos (una fila, sin repeticiones). El margen
     derecho negativo compensa el margen interior de la última tarjeta para que
     la fila termine alineada con los paneles de abajo. -->
<Grid Grid.Row="1" Margin="0,14,-12,0">
    <ItemsControl ItemsSource="{Binding Indicadores}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Style="{StaticResource EstiloTarjetaIndicador}" Command="{Binding Comando}">
                    <Grid Margin="14,12,14,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border x:Name="Mosaico" Width="38" Height="38" CornerRadius="9" Background="{StaticResource Color.BorderSoftBrush}" VerticalAlignment="Top">
                            <TextBlock x:Name="Glifo" FontFamily="{StaticResource FuenteIcono}" FontSize="17" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="&#xF158;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Titulo}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Margin="0,2,0,0" Text="{Binding Valor}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,3,0,0" Text="{Binding Detalle}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,2,0,0" Text="{Binding Nota}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Clave}" Value="ventas">
                        <Setter TargetName="Mosaico" Property="Background" Value="{StaticResource Color.InfoBgBrush}"/>
                        <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.InfoTextBrush}"/>
                        <Setter TargetName="Glifo" Property="Text" Value="&#xE8C7;"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Clave}" Value="recepcion">
                        <Setter TargetName="Mosaico" Property="Background" Value="{StaticResource Color.SuccessBgBrush}"/>
                        <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.SuccessTextBrush}"/>
                        <Setter TargetName="Glifo" Property="Text" Value="&#xE896;"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Grid>

<!-- Nivel 2: barra de comandos (prototipo .commandbar) -->
<Grid Grid.Row="2" Margin="0,10,0,0">
    <Border Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,0,10,0" Text="Acciones frecuentes"/>
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding NotaRol}" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                <ItemsControl ItemsSource="{Binding Acciones}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="BotonAccion" Margin="0,0,8,0" MinHeight="36" Cursor="Hand" FocusVisualStyle="{StaticResource EstiloFocoTeclado}" Command="{Binding Comando}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Marco" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource Color.NavBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glifo" FontFamily="{StaticResource FuenteIcono}" FontSize="14" Margin="0,1,7,0" VerticalAlignment="Center" Text="&#xE7EF;"/>
                                <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Titulo}"/>
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Clave}" Value="ventas">
                                <Setter TargetName="BotonAccion" Property="Background" Value="{StaticResource Color.PrimaryBrush}"/>
                                <Setter TargetName="BotonAccion" Property="BorderBrush" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                                <Setter TargetName="BotonAccion" Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
                                <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
                                <Setter TargetName="Glifo" Property="Text" Value="&#xE8C7;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Clave}" Value="recepcion">
                                <Setter TargetName="BotonAccion" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                                <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.PrimaryBrush}"/>
                                <Setter TargetName="Glifo" Property="Text" Value="&#xE896;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Clave}" Value="producto">
                                <Setter TargetName="BotonAccion" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                                <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.PrimaryBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Clave}" Value="conteo">
                                <Setter TargetName="Glifo" Property="Text" Value="&#xE8FD;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Clave}" Value="inventario">
                                <Setter TargetName="Glifo" Property="Text" Value="&#xE721;"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Grid>

<!-- Nivel 3: actividad (protagonista, 2/3 del ancho, hasta 6 filas visibles
     sin scroll) + pendientes (columna angosta, filas compactas). Ambos paneles
     miden su contenido; sin estiramientos artificiales. -->
<Grid Grid.Row="3" Margin="0,12,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Style="{StaticResource EstiloPanelInicio}" Margin="0,0,12,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource EstiloPanelCabeza}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource EstiloTituloPanel}" Text="Actividad reciente"/>
                    <Button Grid.Column="1" Style="{StaticResource EstiloEnlace}" Command="{Binding IrARecepciones}" Content="Ver recepciones"/>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                <StackPanel>
                    <TextBlock Visibility="{Binding HayActividad,Converter={StaticResource BoolToVisibilityInverted}}" Padding="14,18" Style="{StaticResource EstiloEstadoVacio}" Text="Todavía no hay movimientos registrados."/>
                    <ItemsControl Visibility="{Binding HayActividad,Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding Actividad}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid Margin="14,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border x:Name="Mosaico" Width="28" Height="28" CornerRadius="7" Background="{StaticResource Color.BorderSoftBrush}" VerticalAlignment="Top">
                                            <TextBlock x:Name="Glifo" FontFamily="{StaticResource FuenteIcono}" FontSize="13" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="&#xE823;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,10,0">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Descripcion}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,2,0,0" Text="{Binding Detalle}" TextTrimming="CharacterEllipsis" Visibility="{Binding HayDetalle,Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" VerticalAlignment="Top" Margin="8,1,0,0" Text="{Binding ResponsableYFecha}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <Border Grid.Row="1" Height="1" Background="{StaticResource Color.BorderSoftBrush}"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Clave}" Value="recepcion">
                                        <Setter TargetName="Mosaico" Property="Background" Value="{StaticResource Color.SuccessBgBrush}"/>
                                        <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.SuccessTextBrush}"/>
                                        <Setter TargetName="Glifo" Property="Text" Value="&#xE896;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Clave}" Value="conteo">
                                        <Setter TargetName="Mosaico" Property="Background" Value="{StaticResource Color.WarningBgBrush}"/>
                                        <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.WarningTextBrush}"/>
                                        <Setter TargetName="Glifo" Property="Text" Value="&#xE8FD;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Clave}" Value="apartado">
                                        <Setter TargetName="Mosaico" Property="Background" Value="{StaticResource Color.InfoBgBrush}"/>
                                        <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.InfoTextBrush}"/>
                                        <Setter TargetName="Glifo" Property="Text" Value="&#xE72E;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Clave}" Value="reincorporado">
                                        <Setter TargetName="Mosaico" Property="Background" Value="{StaticResource Color.SuccessBgBrush}"/>
                                        <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.SuccessTextBrush}"/>
                                        <Setter TargetName="Glifo" Property="Text" Value="&#xE73E;"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Clave}" Value="baja">
                                        <Setter TargetName="Mosaico" Property="Background" Value="{StaticResource Color.ErrorBgBrush}"/>
                                        <Setter TargetName="Glifo" Property="Foreground" Value="{StaticResource Color.ErrorTextBrush}"/>
                                        <Setter TargetName="Glifo" Property="Text" Value="&#xE74D;"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{StaticResource Color.Surface2Brush}" BorderBrush="{StaticResource Color.BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="14,7">
                <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Inicio resume los últimos movimientos; el detalle completo de cada módulo se ve en su sección."/>
            </Border>
        </Grid>
    </Border>

    <Border Grid.Column="1" Style="{StaticResource EstiloPanelInicio}" VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource EstiloPanelCabeza}">
                <TextBlock Style="{StaticResource EstiloTituloPanel}" Text="Para revisar"/>
            </Border>
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <Button Style="{StaticResource EstiloFilaPendiente}" Command="{Binding IrAConteos}" Visibility="{Binding HayConteosPendientes,Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="14,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Color.WarningBgBrush}" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="13" Foreground="{StaticResource Color.WarningTextBrush}" Text="&#xE7BA;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,8,0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding TextoConteosPendientes}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,2,0,0" Text="Revisá y aprobá cada conteo desde Inventario." TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource EstiloPildora}" Background="{StaticResource Color.WarningBgBrush}" Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource EstiloTextoPildora}" Foreground="{StaticResource Color.WarningTextBrush}" Text="Pendiente"/>
                        </Border>
                        <TextBlock Grid.Column="3" FontFamily="{StaticResource FuenteIcono}" FontSize="13" Foreground="{StaticResource Color.TextSecondaryBrush}" VerticalAlignment="Center" Text="&#xE76C;"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource EstiloFilaPendiente}" Command="{Binding IrAInventario}" Visibility="{Binding HayApartado,Converter={StaticResource BoolToVisibility}}">
                    <Grid Margin="14,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource Color.InfoBgBrush}" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource FuenteIcono}" FontSize="13" Foreground="{StaticResource Color.InfoTextBrush}" Text="&#xE72E;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,8,0">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding TextoApartado}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Margin="0,2,0,0" Text="Revisá si corresponde reincorporarlas o darlas de baja." TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource EstiloPildora}" Background="{StaticResource Color.InfoBgBrush}" Margin="4,0,8,0">
                            <TextBlock Style="{StaticResource EstiloTextoPildora}" Foreground="{StaticResource Color.InfoTextBrush}" Text="Inventario"/>
                        </Border>
                        <TextBlock Grid.Column="3" FontFamily="{StaticResource FuenteIcono}" FontSize="13" Foreground="{StaticResource Color.TextSecondaryBrush}" VerticalAlignment="Center" Text="&#xE76C;"/>
                    </Grid>
                </Button>
                <TextBlock Visibility="{Binding HayPendientes,Converter={StaticResource BoolToVisibilityInverted}}" Padding="14,16" Style="{StaticResource EstiloEstadoVacio}" Text="No hay asuntos por revisar."/>
            </StackPanel>
        </Grid>
    </Border>
</Grid>
</Grid>
</ScrollViewer>
</UserControl>
