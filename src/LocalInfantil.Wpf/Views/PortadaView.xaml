<UserControl x:Class="LocalInfantil.Wpf.Views.PortadaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ScrollViewer x:Name="ScrollPortada" VerticalScrollBarVisibility="Auto" Background="{StaticResource Color.CanvasBrush}">
<Grid Margin="20,12,20,14" MinHeight="{Binding ViewportHeight, ElementName=ScrollPortada}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Inicio"/><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Bienvenida}"/><TextBlock Style="{StaticResource EstiloAyuda}" Text="Resumen operativo local."/></StackPanel>
<ItemsControl Grid.Row="1" ItemsSource="{Binding Acciones}" Margin="0,0,0,10"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource EstiloBotonSecundario}" Content="{Binding Titulo}" Command="{Binding Comando}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource EstiloTarjeta}" Margin="0,0,10,0"><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="Para revisar"/><Button Visibility="{Binding HayConteosPendientes,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource EstiloBotonQuiet}" Command="{Binding IrAConteos}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding TextoConteosPendientes}"/><Button Visibility="{Binding HayApartado,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource EstiloBotonQuiet}" Command="{Binding IrAInventario}" HorizontalAlignment="Left" Margin="0,4,0,0" Content="{Binding TextoApartado}"/><TextBlock Visibility="{Binding HayPendientes,Converter={StaticResource BoolToVisibilityInverted}}" Style="{StaticResource EstiloEstadoVacio}" Text="No hay asuntos pendientes."/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Margin="0"><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Text="Estado de inventario"/><TextBlock Style="{StaticResource EstiloNumeroMetricaDestacado}" Text="{Binding Inventario.Disponible}"/><TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Disponible"/><TextBlock Margin="0,8,0,0" Text="{Binding Inventario.Fisico,StringFormat={}Físico · {0}}"/><TextBlock Text="{Binding Inventario.Apartado,StringFormat={}Apartado · {0}}"/><TextBlock Style="{StaticResource EstiloAyuda}" Text="Físico = Disponible + Apartado"/></StackPanel></Border></Grid>
<Border Grid.Row="3" Style="{StaticResource EstiloTarjeta}" Margin="0"><StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" Text="Actividad reciente"/><TextBlock Visibility="{Binding HayActividad,Converter={StaticResource BoolToVisibilityInverted}}" Style="{StaticResource EstiloEstadoVacio}" Text="Todavía no hay actividad reciente para mostrar."/><ItemsControl Visibility="{Binding HayActividad,Converter={StaticResource BoolToVisibility}}" ItemsSource="{Binding Actividad}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Descripcion}"/><TextBlock Style="{StaticResource EstiloAyuda}" Text="{Binding Detalle}"/></StackPanel><TextBlock Grid.Column="1" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding ResponsableYFecha}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></Grid>
</ScrollViewer>
</UserControl>
