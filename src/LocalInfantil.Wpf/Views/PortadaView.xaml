<UserControl x:Class="LocalInfantil.Wpf.Views.PortadaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="Inicio"/>
        <TextBlock Margin="0,8,0,0" FontSize="15" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Bienvenida, Mode=OneWay}"/>
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap" Text="Usá el menú superior para ir a Catálogo, Compras, Inventario o Administración."/>
        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Color.TextSecondaryBrush}" TextWrapping="Wrap" Text="{Binding NotaRol, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
