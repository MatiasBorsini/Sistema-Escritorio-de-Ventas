<UserControl x:Class="LocalInfantil.Wpf.Views.RecepcionesConsultaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{StaticResource Color.CanvasBrush}">
        <StackPanel DockPanel.Dock="Top" Margin="20,12,20,0">
            <TextBlock Style="{StaticResource EstiloTituloPagina}" Text="Recepciones" Margin="0,0,0,0"/>
            <TextBlock Style="{StaticResource EstiloAyuda}" Text="Consultá ingresos de mercadería y abrí el detalle completo solo cuando lo necesites." Margin="0,0,0,2"/>
            <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding Resumen}" Margin="0,0,0,4"/>
            <ProgressBar Style="{StaticResource EstiloOcupado}" Visibility="{Binding Ocupado, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Style="{StaticResource EstiloMensajeError}" Text="{Binding Error}"/>
            <TextBlock Style="{StaticResource EstiloMensajeExito}" Text="{Binding Mensaje}"/>
            <StackPanel Style="{StaticResource EstiloToolbar}" Orientation="Horizontal" Margin="0,2,0,4">
                <TextBox Style="{StaticResource EstiloCampoTexto}" Width="240" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}" ToolTip="Comprobante o proveedor"/>
                <Button Style="{StaticResource EstiloBotonPrimario}" Content="Buscar" Command="{Binding CargarCommand}"/>
                <ComboBox Style="{StaticResource EstiloCombo}" Width="130" ItemsSource="{Binding FiltrosEstado}" SelectedItem="{Binding FiltroEstado}" ToolTip="Estado"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Filas:" Margin="8,0,4,0"/>
                <ComboBox Style="{StaticResource EstiloCombo}" Width="70" ItemsSource="{Binding TamanosPagina}" SelectedItem="{Binding TamanoPagina}"/>
                <Button Style="{StaticResource EstiloBotonSecundario}" Content="◀ Anterior" Command="{Binding AnteriorCommand}" IsEnabled="{Binding HayAnterior}" Margin="8,0,0,0"/>
                <Button Style="{StaticResource EstiloBotonSecundario}" Content="Siguiente ▶" Command="{Binding SiguienteCommand}" IsEnabled="{Binding HaySiguiente}"/>
            </StackPanel>
        </StackPanel>
        <Grid Margin="20,2,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource EstiloTarjeta}" Margin="0,0,12,0" Padding="{StaticResource RellenoPanel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource EstiloEtiqueta}" Text="Historial" Margin="0,0,0,6"/>
                    <DataGrid x:Name="Grilla" Style="{StaticResource EstiloGrillaOperativa}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              SelectionUnit="FullRow" CanUserSortColumns="False"
                              ItemsSource="{Binding Historial}" SelectedItem="{Binding FilaSeleccionada}"
                              MouseDoubleClick="Grilla_MouseDoubleClick"
                              BorderBrush="{StaticResource Color.BorderBrush}" MinHeight="300">
                        <DataGrid.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AbrirDetalleCommand}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}" Width="140"/>
                            <DataGridTextColumn Header="Proveedor" Binding="{Binding Resumen.ProveedorNombre}" Width="2*"/>
                            <DataGridTextColumn Header="Unidades" Binding="{Binding UnidadesTexto}" Width="75"/>
                            <DataGridTemplateColumn Header="Estado" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock x:Name="EstadoTexto" FontSize="12" Foreground="{StaticResource Color.SuccessTextBrush}" Text="Confirmada"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Revertida}" Value="True">
                                                <Setter TargetName="EstadoTexto" Property="Text" Value="Revertida"/>
                                                <Setter TargetName="EstadoTexto" Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding FechaTexto}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource EstiloTarjeta}" Margin="0" Padding="{StaticResource RellenoPanel}" VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="RECEPCIÓN SELECCIONADA"/>
                        <TextBlock Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding FilaSeleccionada.Referencia, FallbackValue=Sin selección}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding FilaSeleccionada.Resumen.ProveedorNombre, FallbackValue=—}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding FilaSeleccionada.FechaTexto, FallbackValue=—}"/>
                        <TextBlock FontSize="12" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="{Binding ResponsableDetalle, StringFormat=Registrada por {0}, FallbackValue=—}"/>
                        <Border Style="{StaticResource EstiloSeparador}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Unidades"/>
                                <TextBlock Style="{StaticResource EstiloNumeroMetrica}" Text="{Binding UnidadesDetalle, FallbackValue=—}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Líneas"/>
                                <TextBlock Style="{StaticResource EstiloNumeroMetrica}" Text="{Binding LineasDetalle.Count, FallbackValue=—}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource EstiloEtiquetaMetrica}" Text="Importe"/>
                                <TextBlock FontSize="20" FontWeight="Bold" Foreground="{StaticResource Color.PrimaryBrush}" Text="{Binding TotalDetalleExacto, Converter={StaticResource MinorToArs}, FallbackValue=—, TargetNullValue=—}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource EstiloEtiqueta}" Margin="0,12,0,4" Text="Resumen de mercadería"/>
                        <ItemsControl ItemsSource="{Binding PrimerasLineas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Sku}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Color.TextBrush}" Text="{Binding Cantidad, StringFormat={}{0} u.}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource EstiloBotonSecundario}" Content="Ver detalle completo" Command="{Binding AbrirDetalleCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                        <Border Style="{StaticResource EstiloSeparador}"/>
                        <Border Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.DestructiveBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilaSeleccionada}" Value="{x:Null}">
                                            <Setter Property="Opacity" Value="0.55"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Color.DestructiveBrush}" Text="Revertir recepción"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource Color.TextSecondaryBrush}" Text="Solo si necesitás deshacer por completo este ingreso." TextWrapping="Wrap"/>
                                <Button Style="{StaticResource EstiloBotonDangerOutline}" Content="Solicitar reversión" Command="{Binding SolicitarReversionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                <StackPanel Visibility="{Binding ConfirmacionVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource Color.DestructiveBrush}" TextWrapping="Wrap" Text="La reversión resta todo lo ingresado y requiere un motivo."/>
                                    <TextBlock Style="{StaticResource EstiloEtiqueta}" Margin="0,8,0,0" Text="Motivo de la reversión"/>
                                    <TextBox Style="{StaticResource EstiloCampoTexto}" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" TextWrapping="Wrap" MinHeight="60" AcceptsReturn="True"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource EstiloBotonDestructivo}" Content="Confirmar reversión" Command="{Binding ConfirmarReversionCommand}"/>
                                        <Button Style="{StaticResource EstiloBotonQuiet}" Content="Cancelar" Command="{Binding CancelarReversionCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
