<UserControl x:Class="LocalInfantil.Wpf.Views.RecepcionesConsultaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Recepciones — consulta y reversión completa"/>
            <TextBlock Foreground="#DC2626" Text="{Binding Error}" TextWrapping="Wrap"/>
            <TextBlock Foreground="#059669" Text="{Binding Mensaje}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Refrescar" Padding="8,4" Command="{Binding CargarCommand}"/>
                <Button Content="◀ Anterior" Margin="8,0,0,0" Padding="8,4" Command="{Binding AnteriorCommand}"/>
                <Button Content="Siguiente ▶" Margin="4,0,0,0" Padding="8,4" Command="{Binding SiguienteCommand}"/>
                <TextBlock Margin="8,6,0,0" Text="{Binding Desplazamiento, StringFormat=desde {0}}"/>
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" ItemsSource="{Binding Recepciones}" SelectedItem="{Binding Seleccionada}" Margin="0,0,8,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="10"/>
                            <TextBlock Text="{Binding ComprobanteRef, FallbackValue=—}" Foreground="#6B7280" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Seleccionada.ProveedorId, FallbackValue=Seleccione recepción}" FontWeight="SemiBold"/>
                    <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding Seleccionada.OperacionId}"/>
                    <TextBlock Foreground="#6B7280" Text="{Binding Seleccionada.CreadoEn}"/>
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Lineas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding VarianteId}" FontFamily="Consolas" FontSize="10" Width="180" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Cantidad}" Width="60"/>
                                        <TextBlock Text="{Binding CostoUnitarioMinor, Converter={StaticResource MinorToArs}}" Width="120"/>
                                        <TextBlock Text="{Binding Moneda, FallbackValue=—}" Width="60"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" Foreground="#92400E" Text="Reversión: COMPLETA, motivo obligatorio, resta stock; stock insuficiente rechaza toda; no doble." TextWrapping="Wrap"/>
                    <TextBlock FontFamily="Consolas" FontSize="11" Text="{Binding OperacionIdReversion, StringFormat=operacion_id reversión: {0}}"/>
                    <TextBox Margin="0,4,0,0" Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Motivo reversión"/>
                    <TextBlock Foreground="#6B7280" Text="{Binding EstaRevertida, StringFormat=Revertida: {0}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Solicitar reversión" Padding="8,4" Command="{Binding SolicitarReversionCommand}"/>
                    </StackPanel>
                    <Border Margin="0,8,0,0" Padding="8" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" Visibility="{Binding ConfirmacionVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Foreground="#991B1B" TextWrapping="Wrap" Text="¿Confirmás reversión COMPLETA? Se restará stock de todas las líneas."/>
                            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Lineas}">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Cantidad, StringFormat=- {0} x}" FontFamily="Consolas" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Confirmar reversión" Padding="8,4" Command="{Binding ConfirmarReversionCommand}"/>
                                <Button Content="Cancelar" Margin="8,0,0,0" Padding="8,4" Command="{Binding CancelarReversionCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
