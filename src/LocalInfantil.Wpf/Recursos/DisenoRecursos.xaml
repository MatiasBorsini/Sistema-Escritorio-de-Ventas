<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Paleta aprobada en docs/DISENO_UI.md §2. Única definición de colores;
         las vistas usan estas claves semánticas, no valores HEX repetidos. -->
    <Color x:Key="Color.Nav">#263D43</Color>
    <Color x:Key="Color.Canvas">#F2F1EC</Color>
    <Color x:Key="Color.Surface">#FFFDF9</Color>
    <Color x:Key="Color.Surface2">#F8F7F3</Color>
    <Color x:Key="Color.Primary">#286B66</Color>
    <Color x:Key="Color.PrimaryDark">#1F5753</Color>
    <Color x:Key="Color.Accent">#D9A68C</Color>
    <Color x:Key="Color.Text">#26343B</Color>
    <Color x:Key="Color.TextSecondary">#52636A</Color>
    <Color x:Key="Color.Border">#CBD4CF</Color>
    <Color x:Key="Color.BorderSoft">#E5E9E6</Color>
    <Color x:Key="Color.SuccessBg">#E6F3EA</Color>
    <Color x:Key="Color.SuccessText">#205C3F</Color>
    <Color x:Key="Color.InfoBg">#E8F2FA</Color>
    <Color x:Key="Color.InfoText">#244C70</Color>
    <Color x:Key="Color.WarningBg">#FFF2D9</Color>
    <Color x:Key="Color.WarningText">#785016</Color>
    <Color x:Key="Color.ErrorBg">#FBEAEA</Color>
    <Color x:Key="Color.ErrorText">#922D32</Color>
    <Color x:Key="Color.Destructive">#922D32</Color>
    <!-- Único agregado de paleta Fase 2: variante más oscura del destructivo
         para hover/pressed. Mismo matiz, sin azules del tema Windows. -->
    <Color x:Key="Color.DestructiveDark">#6F2227</Color>

    <BitmapImage x:Key="LogoBannerTiNA" UriSource="pack://application:,,,/LocalInfantil.Wpf;component/Assets/Branding/logo.png"/>

    <SolidColorBrush x:Key="Color.NavBrush" Color="{StaticResource Color.Nav}"/>
    <SolidColorBrush x:Key="Color.CanvasBrush" Color="{StaticResource Color.Canvas}"/>
    <SolidColorBrush x:Key="Color.SurfaceBrush" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Color.PrimaryBrush" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Color.AccentBrush" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Color.TextBrush" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Color.TextSecondaryBrush" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Color.BorderBrush" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Color.BorderSoftBrush" Color="{StaticResource Color.BorderSoft}"/>
    <SolidColorBrush x:Key="Color.Surface2Brush" Color="{StaticResource Color.Surface2}"/>
    <SolidColorBrush x:Key="Color.PrimaryDarkBrush" Color="{StaticResource Color.PrimaryDark}"/>
    <SolidColorBrush x:Key="Color.SuccessBgBrush" Color="{StaticResource Color.SuccessBg}"/>
    <SolidColorBrush x:Key="Color.SuccessTextBrush" Color="{StaticResource Color.SuccessText}"/>
    <SolidColorBrush x:Key="Color.InfoBgBrush" Color="{StaticResource Color.InfoBg}"/>
    <SolidColorBrush x:Key="Color.InfoTextBrush" Color="{StaticResource Color.InfoText}"/>
    <SolidColorBrush x:Key="Color.WarningBgBrush" Color="{StaticResource Color.WarningBg}"/>
    <SolidColorBrush x:Key="Color.WarningTextBrush" Color="{StaticResource Color.WarningText}"/>
    <SolidColorBrush x:Key="Color.ErrorBgBrush" Color="{StaticResource Color.ErrorBg}"/>
    <SolidColorBrush x:Key="Color.ErrorTextBrush" Color="{StaticResource Color.ErrorText}"/>
    <SolidColorBrush x:Key="Color.DestructiveBrush" Color="{StaticResource Color.Destructive}"/>
    <SolidColorBrush x:Key="Color.DestructiveDarkBrush" Color="{StaticResource Color.DestructiveDark}"/>

    <!-- Ritmo vertical de escritorio. Las pantallas operativas reutilizan estas
         medidas para evitar espacios arbitrarios y paneles excesivamente altos. -->
    <Thickness x:Key="EspacioPequeno">6</Thickness>
    <Thickness x:Key="EspacioNormal">10</Thickness>
    <Thickness x:Key="EspacioSeccion">16</Thickness>
    <Thickness x:Key="RellenoPanel">14</Thickness>
    <sys:Double x:Key="AlturaCampo">34</sys:Double>
    <sys:Double x:Key="AlturaToolbar">38</sys:Double>

    <!-- Foco de teclado visible y accesible (punteado sobrio, sin chrome azul). -->
    <Style x:Key="EstiloFocoTeclado">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{StaticResource Color.NavBrush}" StrokeThickness="2" StrokeDashArray="2 2" Margin="-3"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Componentes compartidos (manual §3). Claves explícitas: ninguna vista
         recibe estos estilos por implicación; cada pantalla los pide por clave. -->
    <Style x:Key="EstiloTituloPagina" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="EstiloAyuda" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="EstiloEtiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="EstiloTarjeta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="{StaticResource RellenoPanel}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <!-- Botones con estados propios (normal/hover/pressed/disabled/foco).
         Reemplazan el chrome default de Windows: nunca azul/celeste del tema. -->
    <Style x:Key="EstiloBotonPrimario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Color.PrimaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="{StaticResource AlturaCampo}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.NavBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.BorderSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EstiloBotonSecundario" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.BorderSoftBrush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.BorderSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EstiloBotonDestructivo" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Color.DestructiveBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.DestructiveBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="{StaticResource AlturaCampo}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.DestructiveDarkBrush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.DestructiveDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.DestructiveDarkBrush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.NavBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.BorderSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EstiloCampoTexto" TargetType="TextBox">
        <Setter Property="MinHeight" Value="{StaticResource AlturaCampo}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="EstiloCombo" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="{StaticResource AlturaCampo}"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="EstiloMensajeError" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Color.ErrorTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="EstiloMensajeExito" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Color.SuccessTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="EstiloLista" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="EstiloSeparador" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="Margin" Value="0,10,0,10"/>
    </Style>
    <Style x:Key="EstiloNumeroMetrica" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
    </Style>
    <Style x:Key="EstiloNumeroMetricaDestacado" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Color.PrimaryBrush}"/>
    </Style>
    <Style x:Key="EstiloEtiquetaMetrica" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="EstiloEstadoVacio" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="EstiloOcupado" TargetType="ProgressBar">
        <Setter Property="Height" Value="4"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <!-- E0 Fase 2: botones secundarios del sistema (quiet / danger-outline) y
         campo grande para Login. El resto (tablas, stepper, badges) llega con E2+. -->
    <Style x:Key="EstiloBotonQuiet" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="{StaticResource AlturaCampo}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.BorderSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="Transparent"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.BorderSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EstiloBotonDangerOutline" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource Color.DestructiveBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.DestructiveBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="{StaticResource AlturaCampo}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.ErrorBgBrush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.DestructiveDarkBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.DestructiveDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.ErrorBgBrush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.NavBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Color.BorderSoftBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EstiloCampoTextoGrande" TargetType="TextBox" BasedOn="{StaticResource EstiloCampoTexto}">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>
    <!-- Segmented compacto (RadioButton sin chrome): el contenedor va en la
         vista (fondo Surface2). Solo una opción visible a la vez. -->
    <Style x:Key="EstiloSegmento" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Borde" Property="Background" Value="{StaticResource Color.SurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Encabezado de sección dentro de dropdowns nativos: compacto, no tarjeta. -->
    <Style x:Key="EstiloItemSeccionMenu" TargetType="MenuItem">
        <Setter Property="IsEnabled" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Color.TextSecondaryBrush}"/>
    </Style>
    <!-- Ítem de primer nivel de la barra superior: tipografía y estados propios
         (nunca el highlight azul del tema Windows). El indicador de sección
         activa (subrayado Accent) lo dibuja cada cabecera con DataTrigger. -->
    <Style x:Key="EstiloItemMenuPrincipal" TargetType="MenuItem">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource EstiloFocoTeclado}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource Color.SurfaceBrush}" BorderBrush="{StaticResource Color.BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="220">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="480">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.PrimaryDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource Color.PrimaryDarkBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource Color.CanvasBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Aviso informativo compacto (recepción, inventario, proveedores). -->
    <Style x:Key="EstiloAvisoInfo" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Color.InfoBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Color.InfoTextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,6,0,6"/>
    </Style>
    <Style x:Key="EstiloToolbar" TargetType="StackPanel">
        <Setter Property="MinHeight" Value="{StaticResource AlturaToolbar}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EstiloGrillaOperativa" TargetType="DataGrid">
        <Style.Resources>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Color.SuccessBg}"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Color.SuccessBg}"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource Color.Text}"/>
        </Style.Resources>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="ColumnHeaderHeight" Value="30"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowStyle">
            <Setter.Value>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource Color.Surface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource Color.SuccessBgBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource Color.TextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
