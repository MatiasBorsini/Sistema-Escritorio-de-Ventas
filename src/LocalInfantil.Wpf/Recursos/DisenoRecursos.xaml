<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta aprobada en docs/DISENO_UI.md §2. Única definición de colores;
         las vistas usan estas claves semánticas, no valores HEX repetidos. -->
    <Color x:Key="Color.Nav">#263D43</Color>
    <Color x:Key="Color.Canvas">#F2F1EC</Color>
    <Color x:Key="Color.Surface">#FFFDF9</Color>
    <Color x:Key="Color.Primary">#286B66</Color>
    <Color x:Key="Color.Accent">#D9A68C</Color>
    <Color x:Key="Color.Text">#26343B</Color>
    <Color x:Key="Color.TextSecondary">#52636A</Color>
    <Color x:Key="Color.Border">#CBD4CF</Color>
    <Color x:Key="Color.SuccessBg">#E6F3EA</Color>
    <Color x:Key="Color.SuccessText">#205C3F</Color>
    <Color x:Key="Color.InfoBg">#E8F2FA</Color>
    <Color x:Key="Color.InfoText">#244C70</Color>
    <Color x:Key="Color.WarningBg">#FFF2D9</Color>
    <Color x:Key="Color.WarningText">#785016</Color>
    <Color x:Key="Color.ErrorBg">#FBEAEA</Color>
    <Color x:Key="Color.ErrorText">#922D32</Color>
    <Color x:Key="Color.Destructive">#922D32</Color>

    <SolidColorBrush x:Key="Color.NavBrush" Color="{StaticResource Color.Nav}"/>
    <SolidColorBrush x:Key="Color.CanvasBrush" Color="{StaticResource Color.Canvas}"/>
    <SolidColorBrush x:Key="Color.SurfaceBrush" Color="{StaticResource Color.Surface}"/>
    <SolidColorBrush x:Key="Color.PrimaryBrush" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Color.AccentBrush" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Color.TextBrush" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Color.TextSecondaryBrush" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Color.BorderBrush" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Color.SuccessBgBrush" Color="{StaticResource Color.SuccessBg}"/>
    <SolidColorBrush x:Key="Color.SuccessTextBrush" Color="{StaticResource Color.SuccessText}"/>
    <SolidColorBrush x:Key="Color.InfoBgBrush" Color="{StaticResource Color.InfoBg}"/>
    <SolidColorBrush x:Key="Color.InfoTextBrush" Color="{StaticResource Color.InfoText}"/>
    <SolidColorBrush x:Key="Color.WarningBgBrush" Color="{StaticResource Color.WarningBg}"/>
    <SolidColorBrush x:Key="Color.WarningTextBrush" Color="{StaticResource Color.WarningText}"/>
    <SolidColorBrush x:Key="Color.ErrorBgBrush" Color="{StaticResource Color.ErrorBg}"/>
    <SolidColorBrush x:Key="Color.ErrorTextBrush" Color="{StaticResource Color.ErrorText}"/>
    <SolidColorBrush x:Key="Color.DestructiveBrush" Color="{StaticResource Color.Destructive}"/>
</ResourceDictionary>
