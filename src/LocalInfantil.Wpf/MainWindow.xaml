<Window x:Class="LocalInfantil.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalInfantil — Prototipo"
        Width="960"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left"
                Width="190"
                Background="#F3F4F6"
                BorderBrush="#D1D5DB"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="16">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="LocalInfantil" />
                <TextBlock Margin="0,4,0,20" Foreground="#4B5563" Text="Prototipo sin conexión" TextWrapping="Wrap" />

                <Button Padding="10,7"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Binding Inicio}"
                        Content="Inicio" />
                <Button Margin="0,8,0,0"
                        Padding="10,7"
                        HorizontalContentAlignment="Left"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{Binding EstadoPrototipo}"
                        Content="Estado del prototipo" />
            </StackPanel>
        </Border>

        <DockPanel Margin="28">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,18"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Text="{Binding TituloPaginaActual}" />
            <ContentControl Content="{Binding PaginaActual}" />
        </DockPanel>
    </DockPanel>
</Window>
