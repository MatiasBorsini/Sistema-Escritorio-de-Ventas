<Application x:Class="LocalInfantil.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:LocalInfantil.Wpf.ViewModels"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views"
             xmlns:infra="clr-namespace:LocalInfantil.Wpf.Infra">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Recursos/DisenoRecursos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infra:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <infra:BoolToVisibilityInvertedConverter x:Key="BoolToVisibilityInverted"/>
        <infra:BoolInvertidoConverter x:Key="BoolInvertido"/>
        <infra:DiferenciaColorConverter x:Key="DiferenciaColor"/>
        <infra:FechaCortaConverter x:Key="FechaCorta"/>
        <infra:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <infra:MinorToArsConverter x:Key="MinorToArs"/>
        <infra:MinorConSignoToArsConverter x:Key="MinorConSignoToArs"/>
        <infra:CeroVisibleConverter x:Key="CeroVisible"/>
        <infra:CajaTextoHumanoConverter x:Key="CajaTextoHumano"/>
        <DataTemplate DataType="{x:Type viewModels:InicioViewModel}">
            <views:InicioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:EstadoPrototipoViewModel}">
            <views:EstadoPrototipoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:BootstrapDuenaViewModel}">
            <views:BootstrapDuenaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ShellDuenaViewModel}">
            <views:ShellDuenaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ShellEmpleadaViewModel}">
            <views:ShellEmpleadaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AdministracionUsuariosViewModel}">
            <views:AdministracionUsuariosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CatalogoViewModel}">
            <views:CatalogoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ClientesViewModel}">
            <views:ClientesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CuentaCorrienteViewModel}">
            <views:CuentaCorrienteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ProveedoresViewModel}">
            <views:ProveedoresView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RecepcionViewModel}">
            <views:RecepcionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RecepcionesConsultaViewModel}">
            <views:RecepcionesConsultaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ApartadoViewModel}">
            <views:ApartadoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ConteoViewModel}">
            <views:ConteoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AppRootViewModel}">
            <views:AppRootView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PortadaViewModel}">
            <views:PortadaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PosViewModel}">
            <views:PosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:VentasConsultaViewModel}">
            <views:VentasConsultaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CambiosViewModel}">
            <views:CambiosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CajaViewModel}">
            <views:CajaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ArqueoCiegoViewModel}">
            <views:ArqueoCajaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:RespaldosViewModel}">
            <views:RespaldosView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ReportesViewModel}">
            <views:ReportesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ActualizacionesViewModel}">
            <views:ActualizacionesView />
        </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
