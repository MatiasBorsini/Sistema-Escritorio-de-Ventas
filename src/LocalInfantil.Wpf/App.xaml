<Application x:Class="LocalInfantil.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:LocalInfantil.Wpf.ViewModels"
             xmlns:views="clr-namespace:LocalInfantil.Wpf.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewModels:InicioViewModel}">
            <views:InicioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:EstadoPrototipoViewModel}">
            <views:EstadoPrototipoView />
        </DataTemplate>
         
    </Application.Resources>
</Application>
