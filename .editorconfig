root = true

[*.{cs,vb}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true

[*.{csproj,sln,xaml,md}]
charset = utf-8-bom
end_of_line = crlf
indent_style = space
indent_size = 2
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false
